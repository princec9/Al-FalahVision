<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_commission_partner_report_view_list" model="ir.ui.view">
        <field name="name">sale.commission.partner.report.list</field>
        <field name="model">sale.commission.partner.report</field>
        <field name="arch" type="xml">
            <list string="Commission by Sales Person" create="0" edit="0" delete="0">
                <field name="partner_id"/>
                <field name="plan_id"/>
                <field name="commission_based_on" optional="show"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="qty" sum="Total Qty" optional="hide"/>
                <field name="target_amount" optional="show"/>
                <field name="adjustment" sum="Total Adjustments" optional="show"/>
                <field name="achieved" sum="Total Achieved"/>
                <field name="achieved_rate" widget="percentage" optional="show"/>
                <field name="commission" sum="Total Commission"/>
                <field name="formula_note" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="sale_commission_partner_report_view_pivot" model="ir.ui.view">
        <field name="name">sale.commission.partner.report.pivot</field>
        <field name="model">sale.commission.partner.report</field>
        <field name="arch" type="xml">
            <pivot string="Commission by Sales Person">
                <field name="partner_id" type="row"/>
                <field name="date_from" interval="month" type="col"/>
                <field name="achieved" type="measure"/>
                <field name="commission" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="sale_commission_partner_report_view_search" model="ir.ui.view">
        <field name="name">sale.commission.partner.report.search</field>
        <field name="model">sale.commission.partner.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <group>
                    <filter name="group_partner" string="Sales Person"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_plan" string="Plan"
                            context="{'group_by': 'plan_id'}"/>
                    <filter name="group_level" string="Attribution Level"
                            context="{'group_by': 'commission_based_on'}"/>
                    <filter name="group_period" string="Period"
                            context="{'group_by': 'date_from:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sale_commission_partner_report_action" model="ir.actions.act_window">
        <field name="name">Commission by Sales Person</field>
        <field name="res_model">sale.commission.partner.report</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="sale_commission_partner_report_view_search"/>
        <field name="context">{'search_default_group_partner': 1}</field>
    </record>
    <record id="sale_commission_partner_report_action_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="sale_commission_partner_report_view_list"/>
        <field name="act_window_id" ref="sale_commission_partner_report_action"/>
    </record>
    <record id="sale_commission_partner_report_action_pivot" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="sale_commission_partner_report_view_pivot"/>
        <field name="act_window_id" ref="sale_commission_partner_report_action"/>
    </record>


    <!-- Achievements by Sales Person: confirmed order lines per partner -->
    <record id="sale_commission_achievement_partner_view_list" model="ir.ui.view">
        <field name="name">sale.order.line.list.bt.achievement.partner</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <list string="Achievements by Sales Person" create="0" edit="0" delete="0">
                <field name="salesperson_partner_id"/>
                <field name="salesperson_order_date" widget="date"/>
                <field name="order_id"/>
                <field name="product_id"/>
                <field name="product_uom_qty" sum="Total Qty"/>
                <field name="price_subtotal" sum="Total Achieved"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="sale_commission_achievement_partner_view_pivot" model="ir.ui.view">
        <field name="name">sale.order.line.pivot.bt.achievement.partner</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <pivot string="Achievements by Sales Person">
                <field name="salesperson_partner_id" type="row"/>
                <field name="salesperson_order_date" interval="month" type="col"/>
                <field name="price_subtotal" type="measure"/>
                <field name="product_uom_qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="sale_commission_achievement_partner_view_search" model="ir.ui.view">
        <field name="name">sale.order.line.search.bt.achievement.partner</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="salesperson_partner_id"/>
                <field name="order_id"/>
                <field name="product_id"/>
                <group>
                    <filter name="group_partner" string="Sales Person"
                            context="{'group_by': 'salesperson_partner_id'}"/>
                    <filter name="group_month" string="Month"
                            context="{'group_by': 'salesperson_order_date:month'}"/>
                    <filter name="group_product" string="Product"
                            context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sale_commission_achievement_partner_action" model="ir.actions.act_window">
        <field name="name">Achievements by Sales Person</field>
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="domain">[('salesperson_partner_id', '!=', False), ('order_id.state', 'in', ('sale', 'done')), ('display_type', '=', False), ('is_downpayment', '=', False)]</field>
        <field name="search_view_id" ref="sale_commission_achievement_partner_view_search"/>
        <field name="context">{'search_default_group_partner': 1}</field>
    </record>
    <record id="sale_commission_achievement_partner_action_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="sale_commission_achievement_partner_view_list"/>
        <field name="act_window_id" ref="sale_commission_achievement_partner_action"/>
    </record>
    <record id="sale_commission_achievement_partner_action_pivot" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="sale_commission_achievement_partner_view_pivot"/>
        <field name="act_window_id" ref="sale_commission_achievement_partner_action"/>
    </record>
    <menuitem id="sale_commission_achievement_partner_menu"
              name="Achievements by Sales Person"
              parent="sale.menu_sale_report"
              action="sale_commission_achievement_partner_action"
              sequence="89"/>

    <!-- Achievements by Sales Person (orders): used by Attribution Level "Sale Order" -->
    <record id="sale_commission_achievement_order_view_list" model="ir.ui.view">
        <field name="name">sale.order.list.bt.achievement.partner</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <list string="Achievements by Sales Person (Orders)" create="0" edit="0" delete="0">
                <field name="salesperson_partner_id"/>
                <field name="date_order" widget="date"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="amount_untaxed" sum="Total Achieved"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="sale_commission_achievement_order_view_search" model="ir.ui.view">
        <field name="name">sale.order.search.bt.achievement.partner</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="salesperson_partner_id"/>
                <field name="name"/>
                <field name="partner_id"/>
                <group>
                    <filter name="group_partner" string="Sales Person"
                            context="{'group_by': 'salesperson_partner_id'}"/>
                    <filter name="group_month" string="Month"
                            context="{'group_by': 'date_order:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="sale_commission_achievement_order_action" model="ir.actions.act_window">
        <field name="name">Achievements by Sales Person (Orders)</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list</field>
        <field name="domain">[('salesperson_partner_id', '!=', False), ('state', 'in', ('sale', 'done'))]</field>
        <field name="search_view_id" ref="sale_commission_achievement_order_view_search"/>
        <field name="context">{'search_default_group_partner': 1}</field>
    </record>
    <record id="sale_commission_achievement_order_action_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="sale_commission_achievement_order_view_list"/>
        <field name="act_window_id" ref="sale_commission_achievement_order_action"/>
    </record>
    <menuitem id="sale_commission_achievement_order_menu"
              name="Achievements by Sales Person (Orders)"
              parent="sale.menu_sale_report"
              action="sale_commission_achievement_order_action"
              sequence="88"/>

    <!-- Menu entries are server actions: they rebuild the report, then open it. -->
    <record id="sale_commission_partner_report_open_server_action" model="ir.actions.server">
        <field name="name">Commission by Sales Person</field>
        <field name="model_id" ref="model_sale_commission_partner_report"/>
        <field name="state">code</field>
        <field name="code">action = model.action_recalculate()</field>
    </record>
    <record id="sale_commission_partner_report_check_server_action" model="ir.actions.server">
        <field name="name">Commission Setup Check</field>
        <field name="model_id" ref="model_sale_commission_partner_report"/>
        <field name="state">code</field>
        <field name="code">action = model.action_check_setup()</field>
    </record>

    <menuitem id="sale_commission_partner_report_menu"
              name="Commission by Sales Person"
              parent="sale.menu_sale_report"
              action="sale_commission_partner_report_open_server_action"
              sequence="90"/>
    <menuitem id="sale_commission_partner_report_check_menu"
              name="Commission Setup Check"
              parent="sale.menu_sale_report"
              action="sale_commission_partner_report_check_server_action"
              sequence="91"/>

    <record id="ir_cron_sale_commission_partner_report" model="ir.cron">
        <field name="name">Rebuild Commission by Sales Person</field>
        <field name="model_id" ref="model_sale_commission_partner_report"/>
        <field name="state">code</field>
        <field name="code">model._cron_rebuild()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
