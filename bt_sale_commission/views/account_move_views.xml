<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sales Person (Partner) on customer invoices / credit notes and their lines -->
    <record id="account_move_view_form_inherit_bt_salesperson" model="ir.ui.view">
        <field name="name">account.move.form.inherit.bt.salesperson</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_left_group']" position="inside">
                <field name="salesperson_partner_id"
                       invisible="move_type not in ('out_invoice', 'out_refund')"
                       readonly="state == 'cancel'"
                       options="{'no_create': True, 'no_open': True}"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="after">
                <field name="salesperson_partner_id" optional="show"
                       column_invisible="parent.move_type not in ('out_invoice', 'out_refund')"
                       options="{'no_create': True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>

    <record id="account_move_view_search_inherit_bt_salesperson" model="ir.ui.view">
        <field name="name">account.move.search.inherit.bt.salesperson</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="salesperson_partner_id"/>
            </xpath>
        </field>
    </record>

</odoo>
