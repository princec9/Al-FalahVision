<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sales Person flag on the partner -->
    <record id="res_partner_view_form_inherit_bt_salesperson" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.bt.salesperson</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="is_salesperson"/>
                <field name="commission_plan_ids" widget="many2many_tags"
                       invisible="not is_salesperson"/>
            </xpath>
            <xpath expr="//field[@name='website']" position="after">
                <field name="is_salesperson"/>
            </xpath>
        </field>
    </record>

    <!-- Sales Person (Partner) on the sale order and its lines -->
    <record id="sale_order_view_form_inherit_bt_salesperson" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.bt.salesperson</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="salesperson_partner_id"
                       options="{'no_create': True, 'no_open': True}"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_template_id']" position="after">
                <field name="salesperson_partner_id" optional="show"
                       options="{'no_create': True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>

</odoo>
