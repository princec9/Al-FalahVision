<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Manual adjustments (sale.commission.achievement) of sales person partners.
         Own views and action: the native ones work with res.users lines. -->
    <record id="sale_commission_achievement_partner_adjust_view_list" model="ir.ui.view">
        <field name="name">sale.commission.achievement.list.bt.partner</field>
        <field name="model">sale.commission.achievement</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Adjustments by Sales Person">
                <field name="date"/>
                <field name="add_partner_id"/>
                <field name="reduce_partner_id"/>
                <field name="achieved" sum="Total"/>
                <field name="note"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="sale_commission_achievement_partner_adjust_view_form" model="ir.ui.view">
        <field name="name">sale.commission.achievement.form.bt.partner</field>
        <field name="model">sale.commission.achievement</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Adjustment by Sales Person">
                <sheet>
                    <group>
                        <group>
                            <field name="add_partner_id"
                                   required="not reduce_partner_id"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="reduce_partner_id"
                                   required="not add_partner_id"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="achieved"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sale_commission_achievement_partner_adjust_view_search" model="ir.ui.view">
        <field name="name">sale.commission.achievement.search.bt.partner</field>
        <field name="model">sale.commission.achievement</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <search>
                <field name="add_salesperson_id" string="Sales Person"
                       filter_domain="['|', ('add_salesperson_id', 'ilike', self), ('reduce_salesperson_id', 'ilike', self)]"/>
                <field name="note"/>
                <group>
                    <filter name="group_added" string="Added to"
                            context="{'group_by': 'add_salesperson_id'}"/>
                    <filter name="group_reduced" string="Reduced from"
                            context="{'group_by': 'reduce_salesperson_id'}"/>
                    <filter name="group_month" string="Month"
                            context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sale_commission_achievement_partner_adjust_action" model="ir.actions.act_window">
        <field name="name">Adjustments by Sales Person</field>
        <field name="res_model">sale.commission.achievement</field>
        <field name="view_mode">list,form</field>
        <field name="domain">['|', ('add_partner_id', '!=', False), ('reduce_partner_id', '!=', False)]</field>
        <field name="search_view_id" ref="sale_commission_achievement_partner_adjust_view_search"/>
    </record>
    <record id="sale_commission_achievement_partner_adjust_action_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="sale_commission_achievement_partner_adjust_view_list"/>
        <field name="act_window_id" ref="sale_commission_achievement_partner_adjust_action"/>
    </record>
    <record id="sale_commission_achievement_partner_adjust_action_form" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="sale_commission_achievement_partner_adjust_view_form"/>
        <field name="act_window_id" ref="sale_commission_achievement_partner_adjust_action"/>
    </record>

    <menuitem id="sale_commission_achievement_partner_adjust_menu"
              name="Adjustments by Sales Person"
              parent="sale.menu_sale_report"
              action="sale_commission_achievement_partner_adjust_action"
              groups="sales_team.group_sale_manager"
              sequence="92"/>

</odoo>
