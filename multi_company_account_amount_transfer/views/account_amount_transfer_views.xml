<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id='account_amount_transfer_form_view' model='ir.ui.view'>
            <field name="name">account.amount.transfer.form</field>
            <field name="model">account.amount.transfer</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                        <button name="post_internal_transfer" type="object" string="Post Journal Entries"
                                invisible="state != 'draft'" class="oe_highlight" data-hotkey="p"/>
                        <button name="reset_to_draft" type="object" string="Reset to Draft" invisible="state != 'posted'"
                                class="oe_highlight" data-hotkey="r"/>
                        <button name="cancel_entries" type="object" string="Cancel Entries" invisible="state != 'draft'"
                                class="oe_highlight" data-hotkey="w"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button type="object" name="action_view_journal_entries" class="oe_stat_button"
                                    icon="fa-comment" invisible="entries_count == 0">
                                <field name="entries_count" widget="statinfo" string="Entries"/>
                            </button>
                        </div>
                        <div class="oe_title">
<!--                            <span class="o_form_label">Reference #</span>-->
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="ref" required="1" readonly="state != 'draft'"/>
                                <field name="date" required="1" readonly="state != 'draft'"/>
                            </group>
                            <group>
                                <field name="user_id" readonly="state != 'draft'"/>
                                <field name="journal_entry_ids" readonly="1" widget="many2many_tags"
                                       invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page id="transfer_lines" string="Transfer Lines">
                                <field name="transfer_lines" mode="list"
                                       context="{'transfer_lines': transfer_lines,  'default_transfer_id': id}">
                                    <list editable="bottom" string="Transfer Lines" default_order="sequence">
                                        <field name="sequence" widget="handle"/>

                                        <!--                                        &lt;!&ndash; Displayed fields &ndash;&gt;-->
                                        <field name="transfer_id" column_invisible="True"/>
                                        <field name="date" column_invisible="True"/>
                                        <field name="company_id" required="1"/>
                                        <field name="journal" required="1" domain="[('company_id', '=', company_id),
                              ('type', '=', 'general')]"/>
                                        <field name="account" required="1" domain="[('company_ids', 'parent_of', company_id)]"/>
<!--                                        <field name="asset_category_id" readonly="1"/>-->
                                        <field name="partner_id"
                                               domain="['|', ('parent_id', '=', False), ('is_company', '=', True)]"/>
                                        <field name="name" string="Remark"/>

                                        <field name="analytic_distribution" widget="analytic_distribution"
                                               groups="analytic.group_analytic_accounting"
                                               optional="hide"
                                               options="{'account_field': 'account'}"
                                        />
<!--                                        <field name="employee_name"/>-->
<!--                                        <field name="vehicle_id"/>-->
<!--                                        <field name="customer_segment_id"/>-->
                                        <field name="debit" widget="monetary" sum="Sum of Debit"/>
                                        <field name="credit" widget="monetary" sum="Sum of Credit"/>
                                        <field name="currency_id" invisible="1"/>
                                        <!--                                        <field name="tax_tag_ids"-->
                                        <!--                                               widget="many2many_tags"-->
                                        <!--                                               string="Tax Grids"-->
                                        <!--                                               optional="show"-->
                                        <!--                                               options="{'no_create': True}"/>-->

                                    </list>
                                    <!-- Form view to cover mobile use -->
                                    <form>
                                        <group>
                                            <field name="transfer_id" invisible="1"/>
                                            <field name="date" invisible="1"/>
                                            <field name="name"/>
                                            <field name="company_id"/>
                                            <field name="journal" domain="[('company_id', '=', company_id),
                                       ('type', '=', 'general')]"/>
                                            <field name="account" domain="[('company_ids', 'parent_of', company_id)]"/>
                                            <field name="partner_id"
                                                   domain="['|', ('parent_id', '=', False), ('is_company', '=', True)]"/>
                                            <field name="analytic_distribution" widget="analytic_distribution"
                                                   groups="analytic.group_analytic_accounting"
                                                   options="{'account_field': 'account'}"
                                            />
                                            <field name="debit" widget="monetary"/>
                                            <field name="credit" widget="monetary"/>
                                            <field name="currency_id" invisible="1"/>
                                        </group>
                                    </form>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record model='ir.ui.view' id='account_amount_transfer_list_view'>
            <field name="name">account.amount.transfer.list</field>
            <field name="model">account.amount.transfer</field>
            <field name="arch" type="xml">
                <list>
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="ref"/>
                    <field name="date"/>
                    <field name="user_id"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="account_amount_transfer_action" model="ir.actions.act_window">
            <field name="name">Multi Company Account Amount Transfer</field>
            <field name="res_model">account.amount.transfer</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Create your first transfer
                </p>
            </field>
        </record>

        <menuitem id="account_amount_transfer_action_menuitem"
          name="Multi Company Account Amount Transfer"
          parent="account.menu_finance_entries"
          sequence="4"
          action="multi_company_account_amount_transfer.account_amount_transfer_action"
          groups="multi_company_account_amount_transfer.group_multi_company_accounts_transfer"/>
    </data>
</odoo>