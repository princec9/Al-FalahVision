<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vendor_in_out_report_list" model="ir.ui.view">
        <field name="name">vendor.in.out.report.list</field>
        <field name="model">vendor.in.out.report</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="partner_id" string="Vendor" placeholder="No Vendor"/>
                <field name="product_id"/>
                <field name="categ_id" optional="hide"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                <field name="date" optional="hide"/>
                <field name="qty_purchased" sum="Total"/>
                <field name="qty_adjusted" sum="Total"/>
                <field name="qty_sold" sum="Total"/>
                <field name="qty_available" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="vendor_in_out_report_pivot" model="ir.ui.view">
        <field name="name">vendor.in.out.report.pivot</field>
        <field name="model">vendor.in.out.report</field>
        <field name="arch" type="xml">
            <pivot string="Vendor In/Out" disable_linking="1">
                <field name="partner_id" type="row"/>
                <field name="qty_purchased" type="measure"/>
                <field name="qty_adjusted" type="measure"/>
                <field name="qty_sold" type="measure"/>
                <field name="qty_available" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="vendor_in_out_report_search" model="ir.ui.view">
        <field name="name">vendor.in.out.report.search</field>
        <field name="model">vendor.in.out.report</field>
        <field name="arch" type="xml">
            <search string="Vendor In/Out">
                <field name="partner_id" string="Vendor"/>
                <field name="product_id"/>
                <field name="categ_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="date" string="Month"/>
                <separator/>
                <filter name="no_vendor" string="No Vendor" domain="[('partner_id', '=', False)]"/>
                <filter name="with_vendor" string="With Vendor" domain="[('partner_id', '!=', False)]"/>
                <filter name="has_available" string="Available not zero"
                        domain="[('qty_available', '!=', 0)]"/>
                <separator/>
                <filter name="g_vendor" string="Vendor" context="{'group_by': 'partner_id'}"/>
                <filter name="g_product" string="Product" context="{'group_by': 'product_id'}"/>
                <filter name="g_category" string="Product Category" context="{'group_by': 'categ_id'}"/>
                <filter name="g_company" string="Company" context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company"/>
                <filter name="g_date" string="Month" context="{'group_by': 'date:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_vendor_in_out_report" model="ir.actions.act_window">
        <field name="name">Vendor In/Out Report</field>
        <field name="res_model">vendor.in.out.report</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="vendor_in_out_report_search"/>
        <field name="context">{'search_default_g_vendor': 1, 'search_default_g_product': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No stock movements yet</p>
            <p>Set a Tracking Vendor on your products. Receipts, sales and inventory
               adjustments of a product are reported under its vendor.</p>
        </field>
    </record>

    <menuitem id="menu_vendor_in_out_report"
              name="Vendor Wise Report"
              parent="stock.menu_warehouse_report"
              action="action_vendor_in_out_report"
              groups="stock.group_stock_user"
              sequence="50"/>
</odoo>
