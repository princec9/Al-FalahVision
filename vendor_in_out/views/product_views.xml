<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product form: Vendors button + Tracking Vendor -->
    <record id="product_template_form_in_out" model="ir.ui.view">
        <field name="name">product.template.form.in.out</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" icon="fa-truck" type="object"
                        name="action_view_vendor_report"
                        groups="stock.group_stock_user">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Vendors</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="tracking_vendor_id"
                       context="{'res_partner_search_mode': 'supplier'}"/>
            </xpath>
        </field>
    </record>

    <!-- Products list (select rows, set the vendor once) -->
    <record id="product_template_list_tracking_vendor" model="ir.ui.view">
        <field name="name">product.template.list.tracking.vendor</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="tracking_vendor_id" optional="show"
                       context="{'res_partner_search_mode': 'supplier'}"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_search_tracking_vendor" model="ir.ui.view">
        <field name="name">product.template.search.tracking.vendor</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="tracking_vendor_id"/>
                <filter name="no_tracking_vendor" string="Without Tracking Vendor"
                        domain="[('tracking_vendor_id', '=', False)]"/>
            </xpath>
            <xpath expr="//filter[@name='group_by_categ_id']" position="after">
                <filter name="group_by_tracking_vendor" string="Tracking Vendor"
                        context="{'group_by': 'tracking_vendor_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
