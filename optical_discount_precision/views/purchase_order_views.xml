<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Display only: show Discount (%) with 2 decimals on purchase lines. -->
    <record id="purchase_order_form_discount_display" model="ir.ui.view">
        <field name="name">purchase.order.form.discount.display</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <!-- Purchase lines list -->
            <xpath expr="//field[@name='order_line']/list//field[@name='discount']" position="attributes">
                <attribute name="digits">[16, 2]</attribute>
            </xpath>
            <!-- Purchase line form -->
            <xpath expr="//field[@name='order_line']/form//field[@name='discount']" position="attributes">
                <attribute name="digits">[16, 2]</attribute>
            </xpath>
            <!-- Purchase lines on mobile -->
            <xpath expr="//field[@name='order_line']/kanban//field[@name='discount']" position="attributes">
                <attribute name="digits">[16, 2]</attribute>
            </xpath>
        </field>
    </record>

    <!-- Purchase Order PDF -->
    <template id="report_purchaseorder_document_discount_display"
              inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//span[@t-field='line.discount']" position="attributes">
            <attribute name="t-options">{'widget': 'float', 'precision': 2}</attribute>
        </xpath>
    </template>

    <!-- Vendor portal -->
    <template id="purchase_order_portal_content_discount_display"
              inherit_id="purchase.purchase_order_portal_content">
        <xpath expr="//div[@t-field='line.discount']" position="attributes">
            <attribute name="t-options">{'widget': 'float', 'precision': 2}</attribute>
        </xpath>
    </template>
</odoo>
