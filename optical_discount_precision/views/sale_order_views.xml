<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Display only: Discount (%) keeps the "Discount" decimal accuracy
         internally but is shown with 2 decimals. -->
    <record id="view_order_form_discount_display" model="ir.ui.view">
        <field name="name">sale.order.form.discount.display</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <!-- Order lines list (column added by optical_prescription) -->
            <xpath expr="//field[@name='order_line']/list//field[@name='discount']" position="attributes">
                <attribute name="digits">[16, 2]</attribute>
            </xpath>
            <!-- Order line form -->
            <xpath expr="//field[@name='order_line']/form//field[@name='discount']" position="attributes">
                <attribute name="digits">[16, 2]</attribute>
            </xpath>
            <!-- Order lines on mobile -->
            <xpath expr="//field[@name='order_line']/kanban//field[@name='discount']" position="attributes">
                <attribute name="digits">[16, 2]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
