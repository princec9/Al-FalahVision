<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Display only: show Discount (%) with 2 decimals on invoice lines. -->
    <record id="view_move_form_discount_display" model="ir.ui.view">
        <field name="name">account.move.form.discount.display</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='discount']" position="attributes">
                <attribute name="digits">[16, 2]</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='discount']" position="attributes">
                <attribute name="digits">[16, 2]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
