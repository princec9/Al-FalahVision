<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="action_server_open_expense_wizard" model="ir.actions.server">
        <field name="name">Expense</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">action = records.action_open_expense_wizard()</field>
    </record>
 <record id="res_config_settings_view_form_expense_details" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.expense.details</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//app[@name='account']" position="inside">

                <block title="Additional Expense " name="expense_details">

                    <setting
                        string="Expense Journal"
                        help="Journal used for expense entries."
                    >
                        <field name="expense_journal_id"/>
                    </setting>

                    <setting
                        string="Account"
                        help="Account used for expense entries."
                    >
                        <field name="expense_account_id"/>
                    </setting>

                </block>

            </xpath>

        </field>
    </record>

 <record id="view_partner_form_insurance_company" model="ir.ui.view">
    <field name="name">res.partner.form.insurance.company</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">

        <xpath expr="//field[@name='category_id']" position="after">
            <field name="is_insurance"/>
<!--            <field name="customer_company"/>-->
        </xpath>

    </field>
</record>
<record id="view_invoice_expense_wizard_form" model="ir.ui.view">
        <field name="name">invoice.expense.wizard.form</field>
        <field name="model">invoice.expense.wizard</field>
        <field name="arch" type="xml">

            <form string="Create Expense">

                <group>
                    <field name="invoice_id"/>
                    <field name="amount"/>
                    <field name="payment_journal_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                </group>

                <footer>
                    <button
                        name="action_create_expense"
                        string="Create Expense"
                        type="object"
                        class="btn-primary"
                    />

                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"
                    />
                </footer>

            </form>

        </field>
    </record>

    <record id="view_account_journal_form_inherit_expense" model="ir.ui.view">
    <field name="name">account.journal.form.inherit.expense</field>
    <field name="model">account.journal</field>
    <field name="inherit_id" ref="account.view_account_journal_form"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='code']" position="after">
            <field name="is_expense_journal"/>
        </xpath>
    </field>
</record>

<record id="view_move_form_inherit_claim" model="ir.ui.view">
    <field name="name">account.move.form.claim</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">


<!--            <xpath expr="//field[@name='invoice_date']" position="after">-->

<!--                <field name="delivery_id"-->
<!--                       readonly="1"-->
<!--                       invisible="move_type != 'out_invoice'"/>-->

<!--            </xpath>-->


        <xpath expr="//div[@name='button_box']" position="inside">
            <button name="action_view_claim_journal"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-file-text-o"
                    invisible="not claim_move_id">
                <field name="claim_move_count"
                       widget="statinfo"
                       string="Claim Journal"/>
            </button>
        </xpath>

        <xpath expr="//group[@name='accounting_info_group']" position="inside">
            <field name="insurance_applicable"
                   invisible="move_type != 'out_invoice'"
                   readonly="claim_move_id"/>

            <field name="claim_amount"
                   invisible="move_type != 'out_invoice' or not insurance_applicable"
                   readonly="claim_move_id"/>

            <field name="insurance_agency_id"
                   invisible="move_type != 'out_invoice' or not insurance_applicable"
                   readonly="claim_move_id"/>
        </xpath>

        <xpath expr="//header" position="inside">
            <button
    name="create_invoice_delivery"
    string="Delivery"
    type="object"
    class="btn-primary"
    invisible="
        not is_direct_invoice
        or state != 'posted'
        or is_reimbursement
        or delivery_id
    "
/>
