    <record id="view_move_line_tree_hide_reference" model="ir.ui.view">
    <field name="name">stock.move.line.tree.hide.reference</field>
    <field name="model">stock.move.line</field>
    <field name="inherit_id" ref="stock.view_move_line_tree"/>
    <field name="arch" type="xml">

        <xpath expr="//field[@name='reference']" position="replace">
        </xpath>

    </field>
</record>
    <record id="view_picking_form_hide_origin" model="ir.ui.view">
    <field name="name">stock.picking.form.hide.origin</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form"/>
    <field name="arch" type="xml">

        <xpath expr="//field[@name='origin']" position="replace"/>

    </field>
</record>





