<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record model="ir.actions.server" id="action_is_reimbursement">
    <field name="name">Generate</field>
    <field name="model_id" ref="account.model_account_move"/>
    <field name="binding_model_id" ref="account.model_account_move"/>
    <field name="binding_view_types">list,form</field>
    <field name="state">code</field>
    <field name="sequence">3</field>
    <field name="code">
if records:
    records.action_generate_reimbursement()
    </field>
</record>

  <record id="action_disable_reimbursement" model="ir.actions.server">
    <field name="name">Support</field>
    <field name="model_id" ref="account.model_account_move"/>
    <field name="binding_model_id" ref="account.model_account_move"/>
    <field name="binding_view_types">list,form</field>
    <field name="state">code</field>
    <field name="sequence">4</field>
    <field name="code">
records.write({'is_reimbursement': False})
    </field>
</record>
    <record id="view_out_invoice_tree_inherit_reimbursement" model="ir.ui.view">
        <field name="name">account.move.list.inherit.reimbursement</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="amount_total_in_currency_signed" position="replace">
                <field name="re_grand_total" string="Total" sum="Total" optional="show" decoration-bf="1"
                       decoration-warning="abnormal_amount_warning" groups="base.group_multi_currency"/>
            </field>
            <field name="amount_untaxed_in_currency_signed" position="replace">
                <field name="re_amount_total" string="Tax Excluded" sum="Total" optional="show" decoration-bf="1"
                       decoration-warning="abnormal_amount_warning" groups="base.group_multi_currency"/>
            </field>
        </field>
    </record>
    <record id="view_invoice_form_inherit_insurance" model="ir.ui.view">

        <field name="name">account.move.form.inherit.Reimbursement</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="before">

                <div invisible="is_reimbursement or not account_reimbursement_line_ids"
                     class="alert alert-warning">
                    <field name="is_reimbursement"/>
                    ⚠️  This invoice is currently in <b>Support</b> status. Kindly revert it back to <b>Generate</b> status ⚠️.
                </div>
            </xpath>
            <xpath expr="//widget[@name='web_ribbon'][last()]" position="after">
                <widget name="web_ribbon"
                        title="Insured"
                        invisible="not is_reimbursement" class="is_reimbursement_ribbon"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <field name="is_reimbursement" invisible="1"/>
                <button name="action_generate_reimbursement" class="btn-primary"
                        invisible="1"
                        string="Generate" type="object"/>
            </xpath>

            <xpath expr="//button[@name='open_payments']" position="attributes">
                <attribute name="invisible">is_reimbursement</attribute>
            </xpath>
            <xpath expr="//page[@name='aml_tab']" position="attributes">
                <attribute name="invisible">is_reimbursement</attribute>
            </xpath>


            <xpath expr="//notebook/page[@id='invoice_tab']" position="attributes">
                <attribute name="invisible">is_reimbursement or move_type == 'entry'</attribute>
            </xpath>
            <xpath expr="//notebook/page[@id='invoice_tab']" position="after">
                <page name="Invoice Lines" invisible="not is_reimbursement">
                    <group>
                        <field name="is_reimbursement" invisible="1"/>
                    </group>
                    <field name="account_reimbursement_line_ids"
                           widget="product_label_section_and_note_field_o2m"
                           mode="list"
                           context="{
                                                           'default_move_type': context.get('default_move_type'),
                                                           'journal_id': journal_id,
                                                           'default_currency_id': currency_id or company_currency_id,
                                                           'default_display_type': 'product',
                                                       }">
                        <list editable="bottom">
                            <field name="product_id"
                                   optional="show"
                                   domain="[('sale_ok', '=', True)] or [('purchase_ok', '=', True)] "/>
                            <field name="quantity" optional="show"/>
                            <field name="product_uom_id" readonly="1"/>
                            <field name="price_unit" string="Price"/>
                            <field name="new_discount" width="50px" string="Disc.%" optional="hide"
                                   force_save="1"/>
                            <field name="discount_amount" string="Discount Amount"/>
                            <field name="tax_ids" widget="many2many_tax_tags"
                                   domain="[('type_tax_use','=','sale')]"
                                   options="{'no_create': True}"
                                   optional="show"/>
                            <field name="price_subtotal"
                                   string="Price Subtotal"/>
                            <field name="price_total"
                                   string="Total"/>
                        </list>
                    </field>
                    <group col="12" class="oe_invoice_lines_tab overflow-hidden">
                        <group colspan="8"></group>
                        <group colspan="4">
                            <group class="oe_subtotal_footer">
                                <field name="re_amount_total" class="oe_subtotal_footer_separator"/>
                                <field name="re_tax_amount" class="oe_subtotal_footer_separator"/>
                                <field name="re_grand_total" string="Paid" invisible="payment_state != 'paid'"/>
                                <hr/>
                                <field name="re_invoice_payments_widget" colspan="2" nolabel="1" widget="html"/>
                                <field name="re_grand_total" string="Gross Total"
                                       class="oe_subtotal_footer_separator"/>
                            </group>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <record id="view_account_journal_form_is_insurance" model="ir.ui.view">
        <field name="name">account.journal.form.is.insurance</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="is_insurance"/>
            </xpath>
        </field>
    </record>

