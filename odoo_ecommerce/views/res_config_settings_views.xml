<odoo>
    <record id="view_res_config_settings_form_mcp" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.odoo_ecommerce.mcp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='companies']" position="after">
                <block title="MCP" id="mcp_settings_container">
                    <setting id="mcp_session_timeout_setting" help="Timeout for MCP sessions (in seconds)">
                        <field name="mcp_session_timeout"/>
                    </setting>
                <setting id="mcp_log_retention_setting" help="Number of days to retain MCP logs. 0 = keep indefinitely.">
                    <field name="mcp_log_retention"/>
                </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>

