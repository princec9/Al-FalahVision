<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_account_journal_form_inherit_account" model="ir.ui.view">
            <field name="name">account.journal.form.inherit.ecommerce</field>
            <field name="model">account.journal</field>
            <field name="inherit_id" ref="account.view_account_journal_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='inbound_payment_method_line_ids']/list" position="inside">
                    <field name="ecommerce_payment_provider_code" optional="hide"/>
                </xpath>

            </field>
        </record>
    </data>
</odoo>
