<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form -->
    <record id="view_account_payment_form_pdc" model="ir.ui.view">
        <field name="name">account.payment.form.pdc</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_method_line_id']" position="after">
                <field name="is_pdc" invisible="1"/>
                <field name="pdc_check_number" invisible="not is_pdc" required="is_pdc"
                       readonly="state != 'draft'"/>
                <field name="pdc_check_date" invisible="not is_pdc" required="is_pdc"
                       readonly="state != 'draft'"/>
            </xpath>
        </field>
    </record>

    <!-- List (Customer Payments, Vendor Payments, all payments) -->
    <record id="view_account_payment_tree_pdc" model="ir.ui.view">
        <field name="name">account.payment.list.pdc</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_method_line_id']" position="after">
                <field name="pdc_check_number" optional="show"/>
                <field name="pdc_check_date" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Search -->
    <record id="view_account_payment_search_pdc" model="ir.ui.view">
        <field name="name">account.payment.search.pdc</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="pdc_check_number"/>
            </xpath>
            <xpath expr="//filter[@name='inbound_filter']" position="before">
                <filter string="PDC (Post-dated Cheques)" name="pdc_filter" domain="[('pdc_check_number', '!=', False)]"/>
                <separator/>
            </xpath>
        </field>
    </record>
</odoo>
