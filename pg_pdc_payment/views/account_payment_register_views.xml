<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_register_form_pdc" model="ir.ui.view">
        <field name="name">account.payment.register.form.pdc</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_method_line_id']" position="after">
                <field name="is_pdc" invisible="1"/>
                <field name="pdc_check_number" invisible="not is_pdc" required="is_pdc"/>
                <field name="pdc_check_date" invisible="not is_pdc" required="is_pdc"/>
            </xpath>
        </field>
    </record>
</odoo>
