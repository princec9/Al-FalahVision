<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_res_config_settings_intercompany_salary" model="ir.ui.view">
        <field name="name">res.config.settings.intercompany.salary</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Intercompany Salary" name="bt_hr_intercompany_salary"
                     groups="hr_payroll.group_hr_payroll_manager">
                    <block title="Intercompany Salary Allocation">

                        <setting string="Strict Percentage Validation"
                                 help="Require contribution percentages to total exactly 100% before saving.">
                            <field name="strict_percentage_validation"/>
                        </setting>

                    </block>

                    <block title="Intercompany Accounts">
                        <setting string="Reimbursement Account" help="Account credited in the source company to offset salary expense (reimbursement).">
                            <field name="intercompany_payroll_credit_account_id"/>
                        </setting>
                        <setting string="Expense Account" help="Expense account debited in the target company to record its share of the cost.">
                            <field name="intercompany_payroll_expense_account_id"/>
                        </setting>
                        <setting string="Intercompany Payroll Journal"
                                 help="Journal for recording intercompany salary allocation entries.">
                            <field name="intercompany_payroll_journal_id"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>