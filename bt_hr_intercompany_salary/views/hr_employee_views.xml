<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_employee_form_intercompany" model="ir.ui.view">
        <field name="name">hr.employee.form.intercompany</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_contributions"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-building"
                        groups="hr.group_hr_user"
                        invisible="not is_multi_company_employee">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="total_contribution_percentage" nolabel="1"/>
                            <span>%</span>
                        </span>
                        <span class="o_stat_text">Allocation</span>
                    </div>
                </button>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Salary Allocation" name="salary_allocation"
                      groups="hr_payroll.group_hr_payroll_user">
                    <group>
                        <group string="Multi-Company Settings">
                            <field name="is_multi_company_employee"/>
                            <field name="contribution_status"
                                   widget="badge"
                                   decoration-success="contribution_status == 'valid'"
                                   decoration-warning="contribution_status == 'incomplete'"
                                   decoration-danger="contribution_status == 'excess'"
                                   decoration-muted="contribution_status == 'empty'"
                                   invisible="not is_multi_company_employee"/>
                            <field name="total_contribution_percentage"
                                   invisible="not is_multi_company_employee"/>
                        </group>
                    </group>

                    <field name="multi_company_ids"
                           context="{'default_employee_id': id}"
                           invisible="not is_multi_company_employee">
                        <list string="Company Contributions"
                              decoration-muted="not active"
                              editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="company_id"/>
                            <field name="contribution_percentage" string="Contribution (%)"/>
                            <field name="intercompany_partner_id" optional="hide"/>
                            <field name="active" optional="show"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>

                    <div class="alert alert-info" role="status"
                         invisible="not is_multi_company_employee">
                        <i class="fa fa-info-circle"/> The total of all active contributions
                        must equal <strong>100%</strong>. The parent company
                        <strong><field name="company_id" nolabel="1" readonly="1"/></strong>
                        should be included if it bears part of the cost.
                    </div>

                    <div class="alert alert-warning" role="alert"
                         invisible="not is_multi_company_employee or contribution_status in ('valid', 'empty')">
                        <i class="fa fa-warning"/>
                        Contribution percentages do not sum to 100%.
                        Current total:
                        <field name="total_contribution_percentage" nolabel="1" readonly="1"/>%
                    </div>
                </page>
            </xpath>

        </field>
    </record>

    <record id="action_hr_employee_contributions" model="ir.actions.act_window">
        <field name="name">Company Contributions</field>
        <field name="res_model">employee.company.contribution</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('employee_id', '=', active_id)]</field>
        <field name="context">{'default_employee_id': active_id}</field>
    </record>

</odoo>
