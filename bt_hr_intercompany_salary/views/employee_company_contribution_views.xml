<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_company_contribution_tree" model="ir.ui.view">
        <field name="name">employee.company.contribution.tree</field>
        <field name="model">employee.company.contribution</field>
        <field name="arch" type="xml">
            <list string="Company Contributions"
                  decoration-muted="not active"
                  editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="company_id"/>
                <field name="contribution_percentage" string="Contribution (%)"/>
                <field name="intercompany_partner_id" optional="hide"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_employee_company_contribution_form" model="ir.ui.view">
        <field name="name">employee.company.contribution.form</field>
        <field name="model">employee.company.contribution</field>
        <field name="arch" type="xml">
            <form string="Company Contribution">
                <sheet>
                    <group>
                        <group string="Company &amp; Employee">
                            <field name="employee_id" readonly="id != False"/>
                            <field name="company_id"/>
                            <field name="contribution_percentage"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Settings">
                            <field name="intercompany_partner_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_employee_company_contribution_search" model="ir.ui.view">
        <field name="name">employee.company.contribution.search</field>
        <field name="model">employee.company.contribution</field>
        <field name="arch" type="xml">
            <search string="Search Contributions">
                <field name="employee_id"/>
                <field name="company_id"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <separator/>
                <group>
                    <filter string="Employee" name="group_employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter string="Company" name="group_company"
                            context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_employee_company_contribution" model="ir.actions.act_window">
        <field name="name">Salary Contributions</field>
        <field name="res_model">employee.company.contribution</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_employee_company_contribution_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No salary contributions defined yet.
            </p>
        </field>
    </record>

</odoo>
