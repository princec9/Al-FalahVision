<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_move_search_intercompany" model="ir.ui.view">
        <field name="name">account.move.search.intercompany_salary_move</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter"/>
        <field name="arch" type="xml">
            <search position="inside">
                <filter string="Intercompany Salary Journal Entries"
                        name="intercompany_salary_move"
                        domain="[('is_intercompany_salary_move', '=', True)]"/>
                <group>
                    <filter string="Source Payslip"
                            name="group_intercompany_payslip"
                            context="{'group_by': 'intercompany_payslip_id'}"/>
                    <filter string="Intercompany Role"
                            name="group_intercompany_role"
                            context="{'group_by': 'intercompany_role'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>