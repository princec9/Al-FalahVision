<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_c9_prescription" model="ir.sequence">
            <field name="name">C9 Prescription</field>
            <field name="code">c9.prescription</field>
            <field name="prefix">PRESC/%(year)s/</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_c9_prescription_import" model="ir.sequence">
            <field name="name">C9 Prescription Import</field>
            <field name="code">c9.prescription.import</field>
            <field name="prefix">IMP/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
