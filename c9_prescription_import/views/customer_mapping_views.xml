<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         c9.customer.mapping.wizard  —  Upload Form (step 1)
    ============================================================ -->
    <record id="view_c9_customer_mapping_wizard_form" model="ir.ui.view">
        <field name="name">c9.customer.mapping.wizard.form</field>
        <field name="model">c9.customer.mapping.wizard</field>
        <field name="arch" type="xml">
            <form string="Customer Mapping">
                <group invisible="state != 'upload'">
                    <field name="state" invisible="1"/>
                    <field name="import_file" filename="filename" widget="binary"/>
                    <field name="filename" invisible="1"/>
<!--                    <p class="text-muted">-->
<!--                        Upload the original customer CSV file containing ACCODE, ACNAME, and TELNO columns.-->
<!--                        The wizard will match customers by Name + Phone to Odoo contacts and-->
<!--                        populate the C9 Customer ID field. After mapping, all unmatched-->
<!--                        prescriptions will be automatically remapped.-->
<!--                    </p>-->
                </group>
                <footer invisible="state != 'upload'">
                    <button name="action_import" type="object" string="Map Customers" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ============================================================
         c9.customer.mapping.wizard  —  Result Form (step 2)
    ============================================================ -->
    <record id="view_c9_customer_mapping_wizard_result" model="ir.ui.view">
        <field name="name">c9.customer.mapping.wizard.result</field>
        <field name="model">c9.customer.mapping.wizard</field>
        <field name="arch" type="xml">
            <form string="Customer Mapping Result" create="false" edit="false">
                <sheet>
                    <div class="oe_title">
                        <h1>Customer Mapping Result</h1>
                    </div>
                    <group>
                        <group string="Summary">
                            <field name="state" invisible="1"/>
                            <field name="total_customers"/>
                            <field name="matched_count"/>
                            <field name="unmatched_count"/>
                            <field name="ambiguous_count"/>
                            <field name="conflict_count"/>
                            <field name="updated_count"/>
                            <field name="already_set_count"/>
                            <field name="skipped_no_phone"/>
                        </group>
                        <group string="Prescription Remapping">
                            <field name="prescriptions_remapped"/>
                        </group>
                    </group>
                    <group string="Unmatched Details" invisible="not result_details">
                        <field name="result_details" nolabel="1" widget="text" readonly="1"/>
                    </group>
                    <group string="Ambiguous Details (Multiple Odoo Matches)" invisible="not ambiguous_details">
                        <field name="ambiguous_details" nolabel="1" widget="text" readonly="1"/>
                    </group>
                    <group string="Conflict Details" invisible="not conflict_details">
                        <field name="conflict_details" nolabel="1" widget="text" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Close" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
