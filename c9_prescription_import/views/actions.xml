<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action: Prescription Records (all) -->
    <record id="action_c9_prescription" model="ir.actions.act_window">
        <field name="name">Prescription Records</field>
        <field name="res_model">c9.prescription</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_c9_prescription_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No prescriptions yet.
            </p>
            <p>Import prescriptions from a CSV or XLSX file using the Import menu.</p>
        </field>
    </record>

    <!-- Action: Unmatched prescriptions only -->
    <record id="action_c9_prescription_unmatched" model="ir.actions.act_window">
        <field name="name">Unmatched Prescriptions</field>
        <field name="res_model">c9.prescription</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_c9_prescription_search"/>
        <field name="domain">[('mapping_status', '=', 'unmatched')]</field>
        <field name="context">{'search_default_unmatched': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No unmatched prescriptions.
            </p>
            <p>
                Rows land here when their CustomerId did not match any customer's
                C9 Customer ID at import time. Set the customer's C9 Customer ID
                (Contacts &#8594; customer form) and re-import, or assign the
                Customer field here manually.
            </p>
        </field>
    </record>

    <!-- Action: Import wizard -->
    <record id="action_c9_prescription_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Prescriptions</field>
        <field name="res_model">c9.prescription.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Action: Import history -->
    <record id="action_c9_prescription_import_history" model="ir.actions.act_window">
        <field name="name">Import History</field>
        <field name="res_model">c9.prescription.import</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <!-- Action: Customer Mapping wizard -->
    <record id="action_c9_customer_mapping_wizard" model="ir.actions.act_window">
        <field name="name">Customer Mapping</field>
        <field name="res_model">c9.customer.mapping.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_c9_customer_mapping_wizard_form"/>
    </record>

    <!-- Action: Remap All Prescriptions (server action) -->
    <record id="action_c9_remap_all_prescriptions" model="ir.actions.server">
        <field name="name">Remap All Prescriptions</field>
        <field name="model_id" ref="model_c9_prescription_import"/>
        <field name="state">code</field>
        <field name="code">
action = env['c9.prescription.import'].action_remap_all_customers()
        </field>
    </record>

</odoo>
