<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         c9.prescription.import  —  List View
    ============================================================ -->
    <record id="view_c9_prescription_import_list" model="ir.ui.view">
        <field name="name">c9.prescription.import.list</field>
        <field name="model">c9.prescription.import</field>
        <field name="arch" type="xml">
            <list string="Import History" default_order="create_date desc">
                <field name="name"/>
                <field name="filename"/>
                <field name="import_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state == 'in_progress'"
                       decoration-danger="state == 'failed'"/>
                <field name="total_rows"/>
                <field name="blank_rows"/>
                <field name="imported_rows"/>
                <field name="matched_rows"/>
                <field name="unmatched_rows"/>
                <field name="skipped_rows"/>
                <field name="error_rows"/>
            </list>
        </field>
    </record>

    <!-- ============================================================
         c9.prescription.import  —  Form View
    ============================================================ -->
    <record id="view_c9_prescription_import_form" model="ir.ui.view">
        <field name="name">c9.prescription.import.form</field>
        <field name="model">c9.prescription.import</field>
        <field name="arch" type="xml">
            <form string="Import Batch" create="false" edit="false">
                <header>
                    <button name="action_remap_customers"
                            type="object"
                            string="Remap Customers"
                            class="btn-primary"
                            icon="fa-refresh"
                            invisible="state != 'done'"
                            confirm="This will remap all unmatched prescriptions in this import batch using current c9_customer_id values. Continue?"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_prescriptions"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o">
                            <field name="prescription_count" widget="statinfo" string="Prescriptions"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="File">
                            <field name="filename"/>
                            <field name="import_date"/>
                            <field name="state" widget="badge"/>
                        </group>
                        <group string="Statistics">
                            <field name="total_rows"/>
                            <field name="blank_rows"/>
                            <field name="imported_rows"/>
                            <field name="matched_rows"/>
                            <field name="unmatched_rows"/>
                            <field name="skipped_rows"/>
                            <field name="error_rows"/>
                        </group>
                    </group>
                    <group string="Unmatched / Error Details" invisible="not unmatched_details">
                        <field name="unmatched_details" nolabel="1" widget="text" readonly="1"/>
                    </group>
                    <group string="Notes" invisible="not notes">
                        <field name="notes" nolabel="1" widget="text" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================
         c9.prescription.import.wizard  —  Form View
    ============================================================ -->
    <record id="view_c9_prescription_import_wizard_form" model="ir.ui.view">
        <field name="name">c9.prescription.import.wizard.form</field>
        <field name="model">c9.prescription.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Prescriptions">
                <group>
                    <field name="import_file" filename="filename" widget="binary"/>
                    <field name="filename" invisible="1"/>
<!--                    <p class="text-muted">-->
<!--                        Accepts .csv or .xlsx files with the standard 49-column prescription-->
<!--                        layout. CustomerId is matched against each customer's C9 Customer ID;-->
<!--                        unmatched rows are still imported and flagged for review.-->
<!--                    </p>-->
                </group>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
