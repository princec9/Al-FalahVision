<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Top-level menu under Sales -->
    <!-- sale.sale_menu_root is the verified Sales top-level menu in Odoo 19 -->
    <menuitem
        id="menu_c9_prescriptions_root"
        name="Prescriptions"
        parent="sale.sale_menu_root"
        sequence="30"
        groups="base.group_user"
    />

    <!-- Prescription records list -->
    <menuitem
        id="menu_c9_prescriptions"
        name="Prescription Records"
        parent="menu_c9_prescriptions_root"
        action="action_c9_prescription"
        sequence="10"
    />

    <!-- Import wizard -->
    <menuitem
        id="menu_c9_prescription_import"
        name="Import Prescriptions"
        parent="menu_c9_prescriptions_root"
        action="action_c9_prescription_import_wizard"
        sequence="20"
    />

    <!-- Unmatched prescriptions -->
    <menuitem
        id="menu_c9_prescription_unmatched"
        name="Unmatched Prescriptions"
        parent="menu_c9_prescriptions_root"
        action="action_c9_prescription_unmatched"
        sequence="30"
    />

    <!-- Import history -->
    <menuitem
        id="menu_c9_prescription_import_history"
        name="Import History"
        parent="menu_c9_prescriptions_root"
        action="action_c9_prescription_import_history"
        sequence="40"
    />

    <!-- Customer Mapping wizard -->
    <menuitem
        id="menu_c9_customer_mapping"
        name="Customer Mapping"
        parent="menu_c9_prescriptions_root"
        action="action_c9_customer_mapping_wizard"
        sequence="25"
    />

    <!-- Remap All Prescriptions -->
    <menuitem
        id="menu_c9_remap_all_prescriptions"
        name="Remap All Prescriptions"
        parent="menu_c9_prescriptions_root"
        action="action_c9_remap_all_prescriptions"
        sequence="35"
    />

</odoo>
