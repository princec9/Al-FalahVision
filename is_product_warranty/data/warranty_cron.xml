<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Scheduled action for automatic daily update of warranty states (Invoice/Renew/Expired) -->
    <record id="ir_cron_update_warranty_states" model="ir.cron">
        <field name="name">Warranty: Update States (To Invoice / To Renew / Expired)</field>
        <field name="model_id" ref="model_product_warranty"/>
        <field name="state">code</field>
        <field name="code">model._cron_update_warranty_states()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

</odoo>