<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_warranty_renewal" model="mail.template">
    <field name="name">Warranty Renew Notification</field>
    <field name="model_id" ref="is_product_warranty.model_product_warranty"/>
    <field name="subject">Your warranty {{ object.receipt_no }} is about to expire</field>
    <field name="email_from">{{ object.salesperson_id.email or object.env.company.email or '' }}</field>
    <field name="body_html" type="html">
        <div style="font-family: sans-serif; font-size: 14px;">
            <p>Dear <t t-out="object.partner_id.name"/>,</p>
            <p>Your warranty for <strong><t t-out="object.product_id.name"/></strong> 
               (Receipt: <t t-out="object.receipt_no"/>) will expire on 
               <strong><t t-out="format_date(object.warranty_end_date)"/></strong>.</p>
            <p>Please renew it before the expiry date to continue enjoying warranty benefits.</p>
            <p>Thank you,<br/><t t-out="object.env.company.name"/></p>
        </div>
    </field>
</record>

    <record id="mail_template_warranty_registration" model="mail.template">
        <field name="name">Warranty Registration</field><field name="model_id" ref="is_product_warranty.model_product_warranty"/>
        <field name="model_id" ref="is_product_warranty.model_product_warranty"/>
        <field name="subject">Warranty Registration Confirmation - {{ object.receipt_no }}</field>
        <field name="email_from">{{ object.salesperson_id.email or object.env.company.email or '' }}</field>
        <field name="body_html" type="html">
            <div style="font-family: Arial, sans-serif; font-size: 16px; line-height: 1.6; color: #333;">
                <p>Dear <strong>
                    <t t-out="object.partner_id.name"/>
                </strong>,
            </p>

            <p>Your warranty for <strong>
                <t t-out="object.product_id.name"/>
            </strong> has been successfully registered.</p>

        <div style="margin: 20px 0;">
            <p style="margin: 5px 0;">
                <strong>Receipt No:</strong>
                <t t-out="object.receipt_no"/>
            </p>
            <p style="margin: 5px 0;">
                <strong>Product:</strong>
                <t t-out="object.product_id.name"/>
            </p>
            <p style="margin: 5px 0;">
                <strong>Serial Number:</strong>
                <t t-out="object.serial_number"/>
            </p>
            <p style="margin: 5px 0;">
                <strong>Model No:</strong>
                <t t-out="object.model_no or 'N/A'"/>
            </p>
            <p style="margin: 5px 0; font-size: 18px; font-weight: bold;">Warranty Start Date: <t t-out="format_date(object.warranty_start_date)"/>
            </p>
            <p style="margin: 5px 0; font-size: 18px; font-weight: bold;">Warranty End Date: <t t-out="format_date(object.warranty_end_date)"/>
            </p>
        </div>

        <p>Please keep this email for your records.</p>

        <p>Thank you,<br/>
        <strong>
            <t t-out="object.env.company.name"/>
        </strong>
    </p>
</div>
</field>
</record>
</odoo>