<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sequence for Warranty Invoices -->
    <record id="seq_warranty_invoice" model="ir.sequence">
        <field name="name">Warranty Invoice Sequence</field>
        <field name="code">warranty.invoice</field>
        <field name="prefix">INV/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Sequence for Product Warranty Receipts -->
    <record id="seq_product_warranty_receipt" model="ir.sequence">
        <field name="name">Warranty Receipt Sequence</field>
        <field name="code">product.warranty.receipt</field>
        <field name="prefix">Receipt/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Sequence for Warranty Claims -->
    <record id="seq_warranty_claim" model="ir.sequence">
        <field name="name">Warranty Claim Sequence</field>
        <field name="code">warranty.claim</field>
        <field name="prefix">CLM/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Pipeline Stages for Warranty Management -->
    <record id="warranty_stage_new" model="warranty.stage">
        <field name="name">New</field>
        <field name="sequence">1</field>
    </record>

    <record id="warranty_stage_maintenance" model="warranty.stage">
        <field name="name">Under Maintenance</field>
        <field name="sequence">27</field>
    </record>

    <record id="warranty_stage_ready" model="warranty.stage">
        <field name="name">Ready to Deliver</field>
        <field name="sequence">28</field>
    </record>

    <record id="warranty_stage_done" model="warranty.stage">
        <field name="name">Done</field>
        <field name="sequence">29</field>
    </record>

    <!-- Sequence for Warranty Certificates -->
    <record id="seq_warranty_certificate" model="ir.sequence">
        <field name="name">Warranty Certificate Sequence</field>
        <field name="code">warranty.certificate</field>
        <field name="prefix">Certificate/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>