<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form -->
    <record id="view_warranty_renewal_wizard" model="ir.ui.view">
        <field name="name">warranty.renewal.wizard.form</field>
        <field name="model">warranty.renewal.wizard</field>
        <field name="arch" type="xml">
            <form string="Warranty Renewal">
                <!-- Fields -->
                <group>
                    <field name="warranty_id" invisible="1"/>
                    <field name="product_id"/>
                    <field name="serial_number"/>
                    <field name="partner_id"/>
                    <field name="renewal_start_date" required="1"/>
                    <field name="renewal_amount" required="1"/>
                </group>
                <!-- Footer buttons -->
                <footer>
                    <button name="action_renew_warranty" string="Renew Warranty" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_warranty_renewal_wizard" model="ir.actions.act_window">
        <field name="name">Warranty Renewal</field>
        <field name="res_model">warranty.renewal.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_product_warranty"/>
        <field name="binding_view_types">form</field>
    </record>
</odoo>
