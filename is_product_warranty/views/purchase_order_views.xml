<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add warranty smart button in Purchase Order form -->
    <record id="view_purchase_order_form_inherit_warranty" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.warranty</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_warranties" type="object" class="oe_stat_button" icon="fa-shield">
                    <field name="warranty_count" widget="statinfo" string="Warranties"/>
                </button>
            </div>
        </field>
    </record>

