<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Warranty Records -->
    <record id="action_new_warranty_list" model="ir.actions.act_window">
        <field name="name">Product Warranty Details</field>
        <field name="res_model">product.warranty</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>

    <!-- Warranty Registration action -->
    <record id="action_warranty_registration" model="ir.actions.act_window">
        <field name="name">Warranty Registration</field>
        <field name="res_model">product.warranty</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Warranty Expired filtered -->
    <record id="action_warranty_expired" model="ir.actions.act_window">
        <field name="name">Warranty Expired</field>
        <field name="res_model">product.warranty</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'expired')]</field>
    </record>

    <!-- Warranty To Be Renew filtered -->
    <record id="action_warranty_to_renew" model="ir.actions.act_window">
        <field name="name">Warranty To Be Renew</field>
        <field name="res_model">product.warranty</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'to_renew')]</field>
    </record>

    <!-- Warranty Renewal filtered -->
    <record id="action_warranty_renewal" model="ir.actions.act_window">
        <field name="name">Warranty Renewal</field>
        <field name="res_model">product.warranty</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('renewal_count', '>', 0)]</field>
    </record>

    <!-- Warranty Invoices -->
    <record id="action_warranty_invoice" model="ir.actions.act_window">
        <field name="name">Warranty Invoices</field>
        <field name="res_model">account.move</field>
        <field name="domain">[('move_type','=','out_invoice')]</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Warranty Products -->
    <record id="action_warranty_product" model="ir.actions.act_window">
        <field name="name">Warranty Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Warranty Team -->
    <record id="action_warranty_team" model="ir.actions.act_window">
        <field name="name">Warranty Team</field>
        <field name="res_model">warranty.team</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Warranty Tags -->
    <record id="action_warranty_tag" model="ir.actions.act_window">
        <field name="name">Warranty Tags</field>
        <field name="res_model">warranty.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Warranty Categories -->
    <record id="action_warranty_category" model="ir.actions.act_window">
        <field name="name">Warranty Categories</field>
        <field name="res_model">warranty.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Warranty Stage List View -->
    <record id="view_warranty_stage_list" model="ir.ui.view">
        <field name="name">warranty.stage.list</field>
        <field name="model">warranty.stage</field>
        <field name="arch" type="xml">
            <list string="Claim Stages" editable="top" default_order="sequence">
                <field name="sequence" widget="handle"/>
                <field name="sequence" string="Sequence" readonly="1"/>
                <field name="name" string="Stage Name"/>
            </list>
        </field>
    </record>

    <!-- Warranty Stage Form View -->
    <record id="view_warranty_stage_form" model="ir.ui.view">
        <field name="name">warranty.stage.form</field>
        <field name="model">warranty.stage</field>
        <field name="arch" type="xml">
            <form string="Claim Stage">
                <sheet>
                    <group>
                        <field name="sequence"/>
                        <field name="name" string="Stage Name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Warranty Stages -->
    <record id="action_warranty_stage" model="ir.actions.act_window">
        <field name="name">Claim Stages</field>
        <field name="res_model">warranty.stage</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Warranty Template -->
    <record id="action_warranty_template" model="ir.actions.act_window">
        <field name="name">Warranty Template</field>
        <field name="res_model">warranty.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Warranty Settings -->
    <record id="action_warranty_configuration" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">main</field>
        <field name="context">{'module': 'is_product_warranty'}</field>
    </record>
</odoo>

