<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add warranty smart button in Invoice form -->
    <record id="view_account_move_form_inherit_warranty" model="ir.ui.view">
        <field name="name">account.move.form.inherit.warranty</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button type="object" name="action_view_warranty_from_invoice"
                    class="oe_stat_button" icon="fa-shield"
                    invisible="not warranty_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Warranty</span>
                    </div>
                </button>
            </div>
        </field>
    </record>
</odoo>
