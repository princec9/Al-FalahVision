<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_product_warranty_tree" model="ir.ui.view">
        <field name="name">product.warranty.tree</field>
        <field name="model">product.warranty</field>
        <field name="arch" type="xml">
            <list string="Product Warranty" default_order="id desc">
                <field name="receipt_no"/>
                <field name="partner_id" required="1"/>
                <field name="phone"/>
                <field name="product_id" required="1"/>
<!--                <field name="serial_number" />-->
                <field name="warranty_start_date" required="1"/>
                <field name="warranty_end_date"/>
                <field name="warranty_type" required="1"/>
                <!-- State badge -->
                <field name="state" widget="badge" decoration-success="state == 'draft'" decoration-info="state == 'to_invoice'" decoration-primary="state == 'invoiced'" decoration-warning="state == 'to_renew'" decoration-danger="state == 'expired'"/>
            </list>
        </field>
    </record>

    <!--  Search View -->
    <record id="view_product_warranty_search" model="ir.ui.view">
        <field name="name">product.warranty.search</field>
        <field name="model">product.warranty</field>
        <field name="arch" type="xml">
            <search>
                <field name="receipt_no" string="Receipt No"/>
                <field name="partner_id" string="Customer"/>
                <field name="product_id" string="Product"/>
<!--                <field name="serial_number" string="Serial No"/>-->
                <field name="warranty_team_id" string="Warranty Team"/>
                <field name="salesperson_id" string="Salesperson"/>
                <filter string="Under Warranty" name="filter_draft" domain="[('state','=','draft')]"/>
                <filter string="To Be Invoice" name="filter_invoice" domain="[('state','=','to_invoice')]"/>
                <filter string="To Be Renew" name="filter_renew" domain="[('state','=','to_renew')]"/>
                <filter string="Expired" name="filter_expired" domain="[('state','=','expired')]"/>
                <filter string="Free Warranty" name="filter_free" domain="[('warranty_type','=','free')]"/>
                <filter string="Paid Warranty" name="filter_paid" domain="[('warranty_type','=','paid')]"/>
                <filter string="Start Date" name="filter_start_date" date="warranty_start_date"/>
                <filter string="End Date" name="filter_end_date" date="warranty_end_date"/>
                <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                <filter string="Warranty Type" name="group_type" context="{'group_by':'warranty_type'}"/>
                <filter string="Customer" name="group_partner" context="{'group_by':'partner_id'}"/>
                <filter string="Product" name="group_product" context="{'group_by':'product_id'}"/>
                <filter string="Salesperson" name="group_sales" context="{'group_by':'salesperson_id'}"/>
                <filter string="Warranty Team" name="group_team" context="{'group_by':'warranty_team_id'}"/>
                <filter string="Tags" name="group_tags" context="{'group_by':'tag_ids'}"/>
            </search>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_product_warranty_form" model="ir.ui.view">
        <field name="name">product.warranty.form</field>
        <field name="model">product.warranty</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Header buttons -->
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" invisible="state != 'new'"/>
<!--                    <button name="%(action_warranty_renewal_wizard)d" string="Renew Warranty" type="action" class="btn-primary" invisible="state not in ['draft', 'to_renew'] or renewal_count &gt; 0"/>-->
<!--                    <button name="%(action_warranty_renewal_wizard)d" string="Renewed" type="action" class="btn-secondary" invisible="renewal_count == 0"/>-->
<!--                    <button name="action_send_registration_mail" string="Send Registration Mail" type="object" class="btn-primary" invisible="state not in ['draft', 'invoiced'] or mail_sent"/>-->
<!--                    <button string="Send Registration Mail" type="object" name="action_send_registration_mail" class="btn-secondary" invisible="not mail_sent or state not in ['draft', 'invoiced']"/>-->
                    <!-- Statusbar -->
                    <field name="state" widget="statusbar" statusbar_visible="new,draft,expired"/>
<!--                    <field name="state" widget="statusbar" statusbar_visible="new,draft,to_invoice,invoiced,to_renew,expired"/>-->
                </header>
                <sheet>
                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_claims" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="claim_count" widget="statinfo" string="Claims"/>
                        </button>
                        <button name="action_view_invoice" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="not invoice_id">
                            <field name="invoice_count" widget="statinfo" string="Invoice"/>
                        </button>
                    </div>

                    <!-- Title -->
                    <div class="oe_title">
                        <h1>
                            <field name="receipt_no" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <!-- Partner Info -->
                        <group string="Partner Details">
                            <field name="sale_order_id" invisible="1"/>
                            <field name="purchase_order_id" invisible="1"/>
                            <field name="partner_id" string="Customer" invisible="purchase_order_id != False"/>
                            <field name="partner_id" string="Vendor" invisible="purchase_order_id == False"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="salesperson_id"/>
                        </group>
                        <!-- Warranty Info -->
                        <group string="Warranty Details">
                            <field name="warranty_team_id"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                            <field name="warranty_type" widget="radio"/>
                            <field name="invoice_id" invisible="warranty_type != 'paid'"/>
                        </group>
                    </group>

                    <group>
                        <!-- Product Info -->
                        <group string="Product">
                            <field name="product_id"/>
<!--                            <field name="serial_number"/>-->
<!--                            <field name="model_no"/>-->
<!--                            <field name="merchant"/>-->
                        </group>
                        <!-- Period Info -->
                        <group string="Warranty Period">
                            <field name="warranty_period"/>
                            <field name="warranty_start_date"/>
                            <field name="warranty_end_date"/>
<!--                            <field name="renewal_count"/>-->
                        </group>
                    </group>

                    <!-- Notebook Tabs -->
                    <notebook>
<!--                        <page string="Warranty History">-->
<!--                            <field name="history_ids">-->
<!--                                <list editable="bottom">-->
<!--                                    <field name="date"/>-->
<!--                                    <field name="warranty_start_date"/>-->
<!--                                    <field name="warranty_end_date"/>-->
<!--                                    <field name="renewal_amount"/>-->
<!--                                    <field name="free_amount"/>-->
<!--                                    <field name="paid_amount"/>-->
<!--                                </list>-->
<!--                            </field>-->
<!--                        </page>-->
                        <page string="Claim History">
                            <field name="warranty_claim_ids" readonly="1">
                                <list>
                                    <field name="name" string="Claim Subject"/>
                                    <field name="claim_date" string="Creation Date"/>
                                    <field name="partner_id" string="Customer"/>
                                    <field name="product_id" string="Product"/>
<!--                                    <field name="serial_number" string="Serial No"/>-->
                                    <field name="state" string="Stage"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                    <!-- Notes -->
                    <group>
                        <field name="comment"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_product_warranty" model="ir.actions.act_window">
        <field name="name">Product Warranty</field>
        <field name="res_model">product.warranty</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_product_warranty_search"/>
    </record>

    <record id="action_warranty_configuration" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">main</field>
        <field name="context">{'module': 'is_product_warranty'}</field>
    </record>
</odoo>
