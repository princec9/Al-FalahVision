<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Product Category Form -->
    <record id="product_category_form_view_inherit_warranty" model="ir.ui.view">
        <field name="name">product.category.form.warranty</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">

            <!-- Add Warranty tab -->
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page name="warranty_details" string="Warranty Details">
                        <group>
                            <!-- Warranty fields -->
                            <group string="Warranty Info">
                                <field name="under_warranty"/>
                                <field name="warranty_period"/>
                            </group>

                            <!-- Renewal fields -->
<!--                            <group string="Renewal Settings">-->
<!--                                <field name="allow_renewal"/>-->
<!--                                <field name="allow_warranty_renewal_times"/>-->
<!--                                <field name="warranty_renewal_period"/>-->
<!--                                <field name="warranty_renewal_cost"/>-->
<!--                            </group>-->
                        </group>
                    </page>
                </notebook>
            </xpath>

        </field>
    </record>
</odoo>
