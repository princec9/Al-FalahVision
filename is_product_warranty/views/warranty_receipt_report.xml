<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report Action -->
    <record id="action_report_warranty_receipt" model="ir.actions.report">
        <field name="name">Warranty Receipt</field>
        <field name="model">product.warranty</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">is_product_warranty.report_warranty_receipt_template</field>
        <field name="print_report_name">'Warranty Receipt - %s' % (object.receipt_no)</field>
        <field name="binding_model_id" ref="model_product_warranty"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Report Template -->
    <template id="report_warranty_receipt_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <!-- Title -->
                        <h2 class="text-center mb-4">Warranty Registration Receipt</h2>

                        <!-- Customer + Team + Tags -->
                        <div class="row mb-4">
                            <div class="col-6">
                                <strong>Customer Address</strong><br/>
                                <span t-field="o.partner_id.name"/><br/>
                                <t t-if="o.partner_id.street">
                                    <span t-field="o.partner_id.street"/><br/>
                                </t>
                                <t t-if="o.partner_id.city">
                                    <span t-field="o.partner_id.city"/>&#160;
                                </t>
                                <t t-if="o.partner_id.state_id">
                                    <span t-field="o.partner_id.state_id.name"/>&#160;
                                </t>
                                <t t-if="o.partner_id.zip">
                                    <span t-field="o.partner_id.zip"/>
                                </t>
                                <t t-if="o.partner_id.city or o.partner_id.state_id or o.partner_id.zip">
                                    <br/>
                                </t>
                                <t t-if="o.partner_id.country_id">
                                    <span t-field="o.partner_id.country_id.name"/><br/>
                                </t>
                                <t t-if="o.phone">
                                    📞&#160;<span t-field="o.phone"/><br/>
                                </t>
                                <t t-if="o.email">
                                    ✉&#160;<span t-field="o.email"/>
                                </t>
                            </div>

                            <div class="col-6">
                                <t t-if="o.warranty_team_id">
                                    <strong>Warranty Team</strong><br/>
                                    <span t-field="o.warranty_team_id.name"/>
                                    <br/><br/>
                                </t>
                                <t t-if="o.tag_ids">
                                    <strong>Tags: </strong>
                                    <t t-foreach="o.tag_ids" t-as="tag">
                                        <span t-esc="tag.name"/>
                                        <t t-if="not tag_last">, </t>
                                    </t>
                                    <br/><br/>
                                </t>
                                <t t-if="o.salesperson_id">
                                    <strong>Salesperson: </strong>
                                    <span t-field="o.salesperson_id.name"/>
                                </t>
                            </div>
                        </div>

                        <!-- Receipt No -->
                        <h3><span t-field="o.receipt_no"/></h3>
                        <br/>

                        <!-- Product Table -->
                        <table class="table table-bordered">
                            <thead style="background-color: #f2f2f2;">
                                <tr>
                                    <th>Product</th>
                                    <th>Model No</th>
                                    <th>Serial No</th>
                                    <th>Warranty Start Date</th>
                                    <th>Warranty End Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><span t-field="o.product_id.name"/></td>
                                    <td><span t-field="o.model_no"/></td>
                                    <td><span t-field="o.serial_number"/></td>
                                    <td><span t-field="o.warranty_start_date"/></td>
                                    <td><span t-field="o.warranty_end_date"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Signatures -->
                        <br/><br/><br/>
                        <div class="row mt-5">
                            <div class="col-6 text-center">
                                ______________________<br/>
                                Signature of Reception
                            </div>
                            <div class="col-6 text-center">
                                ______________________<br/>
                                Signature of Customer
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
