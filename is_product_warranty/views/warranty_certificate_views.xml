<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_warranty_certificate_list" model="ir.ui.view">
        <field name="name">warranty.certificate.list</field>
        <field name="model">warranty.certificate</field>
        <field name="arch" type="xml">
            <!-- Certificate list -->
            <list string="Warranty Certificates">
                <field name="name" string="Certificate No"/>
                <field name="lot_serial_no" string="Lot/Serial No"/>
                <field name="product_id" string="Product Name"/>
                <field name="customer_id" string="Customer Name"/>
                <field name="manufacturing_date" string="Manufacturing Date"/>
                <!-- State badge -->
                <field name="state" widget="badge" decoration-success="state == 'new'" decoration-info="state == 'updated'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_warranty_certificate_form" model="ir.ui.view">
        <field name="name">warranty.certificate.form</field>
        <field name="model">warranty.certificate</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Header buttons -->
                    <button name="action_update" string="Update" type="object" class="btn-primary" invisible="state != 'new'"/>
                    <!-- Statusbar -->
                    <field name="state" widget="statusbar" statusbar_visible="new,updated"/>
                </header>
                <sheet>
                    <!-- Title -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <!-- Warranty + Product -->
                        <group>
                            <field name="warranty_id" string="Warranty"/>
                            <field name="lot_serial_no" string="Lot/Serial No"/>
                            <field name="product_id" string="Product Name"/>
                        </group>
                        <!-- Customer + Lab -->
                        <group>
                            <field name="customer_id" string="Customer Name"/>
                            <field name="manufacturing_date" string="Manufacturing Date"/>
                            <field name="lab_result_certificate" widget="binary" string="Lab Result Certificate" filename="lab_result_filename"/>
                            <field name="lab_result_filename" invisible="1"/>
                        </group>
                    </group>

                    <!-- Template -->
                    <group>
                        <field name="warranty_template_id" string="Warranty Template"/>
                    </group>

                    <!-- Content -->
                    <group>
                        <field name="template_content" widget="html" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_warranty_certificate" model="ir.actions.act_window">
        <field name="name">Warranty Certificates</field>
        <field name="res_model">warranty.certificate</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
