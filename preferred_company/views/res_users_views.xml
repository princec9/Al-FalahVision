<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add Preferred Company field to user preferences form -->
    <record id="view_users_form_preferred_company" model="ir.ui.view">
        <field name="name">res.users.form.preferred.company</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="preferred_company_id"/>
            </xpath>
        </field>
    </record>
</odoo>
