<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit product category form to show Shopify collection and taxonomy mapping -->
    <record id="product_category_form_view_inherit_shopify" model="ir.ui.view">
        <field name="name">product.category.form.inherit.shopify</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='first']" position="after">
                <group name="shopify" string="Shopify Configuration">
                    <field name="shopify_collection_id" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
