<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Metafield Definition Search View -->
    <record id="view_shopify_metafield_definition_search" model="ir.ui.view">
        <field name="name">shopify.metafield.definition.search</field>
        <field name="model">shopify.metafield.definition</field>
        <field name="arch" type="xml">
            <search string="Search Metafield Definitions">
                <field name="name"/>
                <field name="namespace"/>
                <field name="key"/>
                <field name="shopify_definition_id"/>
                <field name="ecommerce_account_id"/>
                <group>
                    <filter string="Shopify Account" name="group_account" context="{'group_by': 'ecommerce_account_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'type'}"/>
                    <filter string="Namespace" name="group_namespace" context="{'group_by': 'namespace'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Metafield Definition List View -->
    <record id="view_shopify_metafield_definition_tree" model="ir.ui.view">
        <field name="name">shopify.metafield.definition.list</field>
        <field name="model">shopify.metafield.definition</field>
        <field name="arch" type="xml">
            <list string="Shopify Metafield Definitions">
                <header>
                    <button name="action_pull_from_shopify" string="Pull from Shopify" type="object"
                            class="btn-primary" icon="fa-download"/>
                </header>
                <field name="name"/>
                <field name="namespace"/>
                <field name="key"/>
                <field name="type"/>
                <field name="shopify_definition_id" readonly="1"/>
                <field name="ecommerce_account_id"/>
                <field name="description" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Metafield Definition Form View -->
    <record id="view_shopify_metafield_definition_form" model="ir.ui.view">
        <field name="name">shopify.metafield.definition.form</field>
        <field name="model">shopify.metafield.definition</field>
        <field name="arch" type="xml">
            <form string="Shopify Metafield Definition">
                <header>
                    <button name="action_pull_from_shopify" string="Pull from Shopify" type="object"
                            class="btn-primary" icon="fa-download"/>
                    <button name="action_mirror_to_shopify" string="Mirror to Shopify" type="object"
                            class="btn-secondary" icon="fa-upload"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Care Instructions, Material"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Configuration">
                            <field name="namespace" placeholder="custom"/>
                            <field name="key" placeholder="e.g. care_instructions"/>
                            <field name="type"/>
                        </group>
                        <group string="Shopify Mapping">
                            <field name="ecommerce_account_id"/>
                            <field name="shopify_definition_id" readonly="1"/>
                            <field name="owner_type" readonly="1"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" placeholder="Add details about this metafield's purpose..."/>
                    </group>
                    <notebook>
                        <page name="product_values" string="Product Values">
                            <field name="product_metafield_ids" readonly="1">
                                <list>
                                    <field name="product_tmpl_id"/>
                                    <field name="value"/>
                                    <field name="shopify_metafield_id" readonly="1"/>
                                    <field name="last_sync_status"
                                           decoration-success="last_sync_status == 'success'"
                                           decoration-danger="last_sync_status in ('error', 'failed')"
                                           widget="badge" readonly="1"/>
                                    <field name="last_sync_direction" readonly="1"/>
                                    <field name="last_sync_date" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for Metafield Definitions -->
    <record id="action_shopify_metafield_definitions" model="ir.actions.act_window">
        <field name="name">Metafield Definitions</field>
        <field name="res_model">shopify.metafield.definition</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_shopify_metafield_definition_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Shopify Product Metafield Definition
            </p>
            <p>
                Centralized Metafield Definitions are automatically made available on all products,
                while each product stores its own separate value for the definition.
            </p>
        </field>
    </record>

    <!-- Menu Item under Shopify -->
    <menuitem id="menu_shopify_metafield_definitions"
              name="Metafield Definitions"
              parent="ecommerce_shopify.shopify_menu_root"
              action="action_shopify_metafield_definitions"
              sequence="50"/>

</odoo>
