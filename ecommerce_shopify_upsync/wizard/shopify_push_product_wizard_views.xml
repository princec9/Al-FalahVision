<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="shopify_push_product_wizard_form" model="ir.ui.view">
        <field name="name">shopify.push.product.wizard.form</field>
        <field name="model">shopify.push.product.wizard</field>
        <field name="arch" type="xml">
            <form string="Push Product to Shopify">
                <group>
                    <field name="ecommerce_account_id"/>
                    <field name="product_ids" widget="many2many_tags"/>
                    <field name="push_all_variants"
                           invisible="not is_multi_variant"/>
                    <field name="is_multi_variant" invisible="1"/>
                </group>
                <footer>
                    <button name="action_push" type="object"
                            string="Push to Shopify"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open wizard from account -->
    <record id="action_shopify_push_product_wizard" model="ir.actions.act_window">
        <field name="name">Push Product to Shopify</field>
        <field name="res_model">shopify.push.product.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>

    <!-- Action to open wizard from product form -->
    <record id="action_shopify_push_from_product" model="ir.actions.act_window">
        <field name="name">Push to Shopify</field>
        <field name="res_model">shopify.push.product.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">form</field>
        <field name="context">{}</field>
    </record>
</odoo>

