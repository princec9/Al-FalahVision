<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_employee_benefits" model="ir.module.category">
        <field name="name">Employee Benefits</field>
        <field name="sequence">10</field>
    </record>

    <record id="privilege_benefit" model="res.groups.privilege">
        <field name="name">Employee Benefits Access</field>
        <field name="category_id" ref="module_category_employee_benefits"/>
    </record>

    <record id="group_benefit_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_benefit"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_benefit_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_benefit"/>
        <field name="implied_ids" eval="[(4, ref('group_benefit_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Record Rules for Benefit Request -->
    <record id="benefit_request_rule_user" model="ir.rule">
        <field name="name">Personal Benefit Requests</field>
        <field name="model_id" ref="model_benefit_request"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('bt_employee_benefits.group_benefit_user'))]"/>
    </record>

    <record id="benefit_request_rule_manager" model="ir.rule">
        <field name="name">All Benefit Requests (Manager)</field>
        <field name="model_id" ref="model_benefit_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('bt_employee_benefits.group_benefit_manager'))]"/>
    </record>

    <!-- Record Rules for Benefit Allocation -->
    <record id="benefit_allocation_rule_user" model="ir.rule">
        <field name="name">Personal Benefit Allocations</field>
        <field name="model_id" ref="model_benefit_allocation"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('bt_employee_benefits.group_benefit_user'))]"/>
    </record>

    <record id="benefit_allocation_rule_manager" model="ir.rule">
        <field name="name">All Benefit Allocations (Manager)</field>
        <field name="model_id" ref="model_benefit_allocation"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('bt_employee_benefits.group_benefit_manager'))]"/>
    </record>
</odoo>
