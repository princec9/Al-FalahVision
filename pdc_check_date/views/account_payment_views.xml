<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_cheque_date" model="ir.ui.view">
        <field name="name">account.payment.form.cheque.date</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_method_line_id']" position="after">
                <field name="is_pdc_method" invisible="1"/>
                <field name="cheque_date"
                       invisible="not is_pdc_method"
                       required="is_pdc_method"
                       readonly="state != 'draft'"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_supplier_payment_tree_cheque_date" model="ir.ui.view">
        <field name="name">account.payment.supplier.list.cheque.date</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_supplier_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date']" position="after">
                <field name="cheque_date" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
