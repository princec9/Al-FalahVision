<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_order_form_intercompany" model="ir.ui.view">
        <field name="name">purchase.order.form.intercompany</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='currency_id']" position="before">

                <field name="is_intercompany_bill" widget="boolean_toggle"/>
                <field name="is_msupply" widget="boolean_toggle"/>

                <field name="company_to_bill_id"
                       invisible="not is_intercompany_bill"
                       required="is_intercompany_bill"/>

            </xpath>

            <xpath expr="//field[@name='picking_type_id']" position="attributes">
                <attribute name="domain">[('code','=','incoming')]</attribute>
            </xpath>

            <xpath expr="//header" position="inside">

                <button name="action_generate_intercompany_bill"
                        type="object"
                        string="Generate Bill"
                        class="btn-primary"
                        invisible="
                            state != 'purchase'
                            or not is_intercompany_bill
                            or invoice_status == 'invoiced'"/>

            </xpath>

        </field>
    </record>

</odoo>
