<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_intercompany" model="ir.ui.view">
        <field name="name">res.company.form.inherit.intercompany</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_registry']" position="after">
                <field name="intercompany_journal_id" invisible="1"/>
                <field name="intercompany_income_account_id" invisible="1"/>
                <field name="intercompany_expense_account_id" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>