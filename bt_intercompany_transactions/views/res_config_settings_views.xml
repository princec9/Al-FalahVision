<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.bt.intercompany.transactions</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='default_accounts']" position="inside">
                    <setting id="intercompany_settings_group"
                             string="Intercompany Journal and Accounts:"
                             company_dependent="1"
                             help="Configure the journal and default accounts for intercompany journal entries.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="intercompany_journal_id" class="col-lg-4 o_light_label" string="Journal"/>
                                <field name="intercompany_journal_id" domain="[('type', '=', 'general'), ('active', '=', True)]"
                                       help="Select the journal to use for intercompany journal entries."/>
                            </div>
                            <div class="row mt8">
                                <label for="intercompany_income_account_id" class="col-lg-4 o_light_label" string="Income Account"/>
                                <field name="intercompany_income_account_id" domain="[('company_ids', 'in', [company_id]), ('account_type', 'in', ('income', 'income_other'))]"
                                       help="Default income account for intercompany journal entries without a product."/>
                            </div>
                            <div class="row mt8">
                                <label for="intercompany_expense_account_id" class="col-lg-4 o_light_label" string="Expense Account"/>
                                <field name="intercompany_expense_account_id" domain="[('company_ids', 'in', [company_id]), ('account_type', 'in', ('expense', 'expense_deprec', 'expense_direct_cost'))]"
                                       help="Default expense account for intercompany journal entries without a product."/>
                            </div>
                        </div>
                    </setting>
            </xpath>
        </field>
    </record>
</odoo>