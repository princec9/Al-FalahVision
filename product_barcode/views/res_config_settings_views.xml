<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_product_barcode" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.product.barcode</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form" position="inside">

                <app string="Product Barcode"
                     name="product_barcode"
                >

                    <block title="Product Barcode Generator">

                        <setting string="Barcode Prefix"
                                 help="Prefix added before the generated barcode sequence.">
                            <field name="barcode_prefix"/>
                        </setting>

                        <setting string="Barcode Padding"
                                 help="Number of digits used for the sequence, for example 6 gives 000001.">
                            <field name="barcode_padding"/>
                        </setting>

                        <setting string="Barcode Suffix"
                                 help="Suffix added after the generated barcode sequence.">
                            <field name="barcode_suffix"/>
                        </setting>

                        <setting string="Barcode Sequence"
                                 help="Sequence used to generate product barcodes.">
                            <field name="barcode_sequence_id"/>
                        </setting>

                    </block>

                </app>

            </xpath>

        </field>
    </record>
    <template id="report_label_zpl_wrap_tag">
        <t t-foreach="docs" t-as="product">
            <t t-translation="off">
                ^XA
                ^CI28
                ^MNY
                ^MD-10
                ^PW520
                ^LL150
                ^LH0,0

                ^FO20,35
                ^BY2,2,50
                ^BCN,50,N,N,N,A
                ^FD<t t-out="product.barcode or ''"/>^FS

                ^FO25,90
                ^A0N,22,18
                ^FB160,1,0,C,0
                ^FD<t t-out="product.default_code or product.barcode or ''"/>^FS

                ^FO310,40
                ^A0N,19,16
                ^FB200,3,2,L,0
                ^FD<t t-out="(product.display_name or '')[:38]"/>^FS

                ^FO310,100
                ^A0N,23,20
                ^FDAED: <t t-out="'%.2f' % product.list_price"/>^FS

                ^XZ
            </t>
        </t>
    </template>

    <record id="action_report_label_zpl_wrap_tag" model="ir.actions.report">
        <field name="name">Wrap Tag Label (ZPL)</field>
        <field name="model">product.template</field>
        <field name="report_type">qweb-text</field>
        <field name="report_name">product_barcode.report_label_zpl_wrap_tag</field>
        <field name="report_file">product_barcode.report_label_zpl_wrap_tag</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_type">report</field>
    </record>

</odoo>