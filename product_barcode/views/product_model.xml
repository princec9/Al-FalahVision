<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_product_model_list" model="ir.ui.view">
        <field name="name">product.model.list</field>
        <field name="model">product.model</field>
        <field name="arch" type="xml">
            <list string="Models">
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_product_model_form" model="ir.ui.view">
        <field name="name">product.model.form</field>
        <field name="model">product.model</field>
        <field name="arch" type="xml">
            <form string="Model">

                <sheet>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                </sheet>

            </form>
        </field>
    </record>

    <!-- Model Search -->
    <record id="view_product_model_search" model="ir.ui.view">
        <field name="name">product.model.search</field>
        <field name="model">product.model</field>
        <field name="arch" type="xml">
            <search string="Models">

                <field name="name"/>

                <filter
                    name="active"
                    string="Active"
                    domain="[('active', '=', True)]"
                />

                <filter
                    name="inactive"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />

            </search>
        </field>
    </record>
    <record id="product_template_form_view_brand_model" model="ir.ui.view">
        <field name="name">product.template.form.brand.model</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Add Brand and Model after Category -->
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="brand_id"/>
                <field name="model_id"/>
            </xpath>
        </field>
    </record>
     <record id="product_product_form_brand_model" model="ir.ui.view">
        <field name="name">product.product.form.brand.model</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="brand_id" readonly="1"/>
                <field name="model_id" readonly="1"/>
            </xpath>

        </field>
    </record>


    <!-- Model Action -->
    <record id="action_product_model" model="ir.actions.act_window">
        <field name="name">Models</field>
        <field name="res_model">product.model</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_product_model_search"/>
    </record>
     <menuitem
        id="menu_product_model"
        name="Models"
        parent="stock.menu_product_in_config_stock"
        action="action_product_model"
        sequence="20"
    />

</odoo>