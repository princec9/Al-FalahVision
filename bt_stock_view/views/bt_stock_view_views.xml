<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bt_stock_view_list" model="ir.ui.view">
        <field name="name">bt.stock.view.list</field>
        <field name="model">bt.stock.view</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="product_name"/>
                <field name="default_code"/>
                <field name="category_name" optional="hide"/>
                <field name="company_name"/>
                <field name="parent_company_name" optional="hide"/>
                <field name="warehouse_name"/>
                <field name="location_name" optional="show"/>
                <field name="lot_name" optional="hide"/>
                <field name="reserved_quantity" sum="Total" optional="hide"/>
                <field name="incoming_qty" sum="Total"/>
                <field name="outgoing_qty" sum="Total"/>
                <field name="sales_qty" sum="Total"/>
                <field name="purchase_qty" sum="Total"/>
                <field name="sales_return_qty" sum="Total"/>
                <field name="purchase_return_qty" sum="Total"/>
                <field name="quantity" sum="Total"/>
                <field name="available_quantity" sum="Total"/>
                <field name="return_date" optional="hide"/>
                <field name="uom_name"/>
            </list>
        </field>
    </record>

    <record id="bt_stock_view_pivot" model="ir.ui.view">
        <field name="name">bt.stock.view.pivot</field>
        <field name="model">bt.stock.view</field>
        <field name="arch" type="xml">
            <pivot string="Stock Overview" disable_linking="1">
                <field name="product_name" type="row"/>
                <field name="company_name" type="col"/>
                <field name="quantity" type="measure"/>
                <field name="incoming_qty" type="measure"/>
                <field name="outgoing_qty" type="measure"/>
                <field name="sales_qty" type="measure"/>
                <field name="purchase_qty" type="measure"/>
                <field name="sales_return_qty" type="measure"/>
                <field name="purchase_return_qty" type="measure"/>
            </pivot>
        </field>
    </record>

