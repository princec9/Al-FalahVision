    <record id="bt_stock_view_action" model="ir.actions.act_window">
        <field name="name">Stock Overview (All Companies)</field>
        <field name="res_model">bt.stock.view</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="bt_stock_view_search"/>
        <field name="context">{'search_default_group_company': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No stock found</p>
        </field>
    </record>

    <menuitem id="menu_bt_stock_view_root"
              name="Stock Overview"
              web_icon="stock,static/description/icon.png"
              groups="bt_stock_view.group_bt_stock_viewer"
              action="bt_stock_view_action"
              sequence="95"/>
