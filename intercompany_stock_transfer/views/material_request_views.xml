<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_material_request_list" model="ir.ui.view">
        <field name="name">material.request.list</field>
        <field name="model">material.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="source_company_id"/>
                <field name="destination_id" context="{'mr_all_companies': True}"
                       options="{'no_create': True, 'no_open': True}"/>
            </list>
        </field>
    </record>

    <record id="view_material_request_form" model="ir.ui.view">
        <field name="name">material.request.form</field>
        <field name="model">material.request</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="source_company_id" readonly="1" force_save="1"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="destination_id"
                               context="{'mr_all_companies': True}"
                               options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <notebook>
                        <page string="Products" name="products">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_material_request_pivot" model="ir.ui.view">
        <field name="name">material.request.pivot</field>
        <field name="model">material.request</field>
        <field name="arch" type="xml">
            <pivot string="Material Requests">
                <field name="source_company_id" type="row"/>
                <field name="destination_id" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="action_material_request" model="ir.actions.act_window">
        <field name="name">Material Requests</field>
        <field name="res_model">material.request</field>
        <field name="view_mode">list,form,pivot</field>
    </record>

    <menuitem id="menu_material_request"
              name="Material Requestss"
              parent="stock.menu_stock_warehouse_mgmt"
              action="action_material_request"
              sequence="50"/>
</odoo>
