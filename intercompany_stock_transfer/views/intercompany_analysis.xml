<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_intercompany_transfer_report_pivot" model="ir.ui.view">
        <field name="name">intercompany.transfer.report.pivot</field>
        <field name="model">intercompany.transfer.report</field>
        <field name="arch" type="xml">
            <pivot string="Inter-Company Analysis" sample="1">
                <field name="source_company_id" type="row"/>
                <field name="destination_company_id" type="col"/>
                <field name="quantity" type="measure"/>
                <field name="line_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_intercompany_transfer_report_graph" model="ir.ui.view">
        <field name="name">intercompany.transfer.report.graph</field>
        <field name="model">intercompany.transfer.report</field>
        <field name="arch" type="xml">
            <graph string="Inter-Company Analysis" type="bar" sample="1">
                <field name="product_id"/>
                <field name="quantity" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_intercompany_transfer_report_list" model="ir.ui.view">
        <field name="name">intercompany.transfer.report.list</field>
        <field name="model">intercompany.transfer.report</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="name"/>
                <field name="transfer_date"/>
                <field name="source_company_id"/>
                <field name="destination_company_id"/>
                <field name="product_id"/>
                <field name="quantity" sum="Total"/>
                <field name="product_uom_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_intercompany_transfer_report_search" model="ir.ui.view">
        <field name="name">intercompany.transfer.report.search</field>
        <field name="model">intercompany.transfer.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_id"/>
                <field name="product_categ_id"/>
                <field name="source_company_id"/>
                <field name="destination_company_id"/>
                <field name="user_id"/>
                <filter name="f_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="f_transit" string="In Transit" domain="[('state', '=', 'in_transit')]"/>
                <filter name="f_received" string="Received" domain="[('state', '=', 'received')]"/>
                <separator/>
                <filter name="f_this_month" string="This Month"
                        domain="[('transfer_date', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="g_source" string="Source Company" context="{'group_by': 'source_company_id'}"/>
                    <filter name="g_dest" string="Destination Company" context="{'group_by': 'destination_company_id'}"/>
                    <filter name="g_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="g_categ" string="Product Category" context="{'group_by': 'product_categ_id'}"/>
                    <filter name="g_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="g_user" string="Responsible" context="{'group_by': 'user_id'}"/>
                    <filter name="g_date" string="Transfer Date" context="{'group_by': 'transfer_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_intercompany_transfer_report" model="ir.actions.act_window">
        <field name="name">Inter-Company Analysis</field>
        <field name="res_model">intercompany.transfer.report</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="context">{'search_default_g_source': 1}</field>
    </record>

    <!-- change parent to your own Inter-Company menu or Inventory > Reporting -->
</odoo>