<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_intercompany_stock_transfer_list" model="ir.ui.view">
        <field name="name">intercompany.stock.transfer.list</field>
        <field name="model">intercompany.stock.transfer</field>
        <field name="arch" type="xml">
            <list string="Inter-Company Transfers">
                <field name="name"/>
                <field name="source_company_id"/>
                <field name="destination_company_id"/>
                <field name="source_warehouse_id"/>
                <field name="destination_warehouse_id"/>
                <field name="transfer_date"/>
                <field name="state"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_intercompany_stock_transfer_form" model="ir.ui.view">
        <field name="name">intercompany.stock.transfer.form</field>
        <field name="model">intercompany.stock.transfer</field>
        <field name="arch" type="xml">
            <form string="Inter-Company Transfer">
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_receive" type="object" string="Receive"
                            class="btn-primary" invisible="state != 'in_transit'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('received', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,in_transit,received,cancelled"/>
                </header>

                <sheet>


                    <div class="oe_button_box" name="button_box">
                        <button
                                name="action_view_stock_quants"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-cubes"
                        >
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">On Hand</span>
                            </div>
                        </button>
                        <button name="action_view_source_picking" type="object"
                                class="oe_stat_button" icon="fa-truck"
                                invisible="not source_picking_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Source Picking</span>
                            </div>
                        </button>
                        <button name="action_view_destination_picking" type="object"
                                class="oe_stat_button" icon="fa-download"
                                invisible="not destination_picking_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Destination Picking</span>
                            </div>
                        </button>

                    </div>

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group string="Transfer Information">
                        <group>
                            <field name="source_company_id"
                                   readonly="1"/>
                            <field name="destination_company_id"
                            />

                        </group>
                        <group>
                            <field name="transfer_date"
                                   readonly="state not in ('draft', 'confirmed')"/>
                            <field name="user_id"
                                   readonly="state not in ('draft', 'confirmed')"/>
                            <field name="notes" placeholder="Add your remarks..."/>
                        </group>
                    </group>

                    <group/>
                    <notebook>
                        <page string="Products">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="product_uom_id"/>
                                    <field name="source_on_hand_qty"/>
                                    <field name="destination_on_hand_qty"/>
                                </list>
                            </field>
                        </page>

                        <page string="Additional Information">
                            <group string="Transfer Information">
                                <group>


                                    <field name="source_picking_id" readonly="1"/>
                                    <field name="destination_picking_id" readonly="1"/>
                                    <field name="transit_location_id"
                                           domain="[('usage', '=', 'transit'), ('company_id', '=', False)]"
                                           readonly="1"/>

                                </group>
                                <group>
                                    <field name="source_warehouse_id"
                                           domain="[('company_id', '=', source_company_id)]"
                                           readonly="state != 'draft'"/>
                                    <field name="source_location_id"
                                           domain="[('company_id', '=', source_company_id), ('usage', '=', 'internal')]"
                                           readonly="1"/>
                                </group>
                                <group>
                                    <field name="destination_warehouse_id"
                                           domain="[('company_id', '=', destination_company_id)]"
                                           readonly="state != 'draft'"/>
                                    <field name="destination_location_id"
                                           domain="[('company_id', '=', destination_company_id), ('usage', '=', 'internal')]"
                                           readonly="state != 'draft'"/>
                                </group>
                            </group>

                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_intercompany_stock_transfer_search" model="ir.ui.view">
        <field name="name">intercompany.stock.transfer.search</field>
        <field name="model">intercompany.stock.transfer</field>
        <field name="arch" type="xml">
            <search string="Inter-Company Transfers">
                <field name="name"/>
                <field name="source_company_id"/>
                <field name="destination_company_id"/>
                <field name="source_warehouse_id"/>
                <field name="destination_warehouse_id"/>
                <field name="user_id"/>
                <field name="state"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="in_transit" string="In Transit" domain="[('state', '=', 'in_transit')]"/>
                <filter name="received" string="Received" domain="[('state', '=', 'received')]"/>
                <group>
                    <filter name="group_source_company" string="Source Company"
                            context="{'group_by': 'source_company_id'}"/>
                    <filter name="group_destination_company" string="Destination Company"
                            context="{'group_by': 'destination_company_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
