<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_intercompany_stock_transfer"
            model="ir.ui.view">

        <field name="name">
            res.config.settings.view.form.intercompany.stock.transfer
        </field>

        <field name="model">res.config.settings</field>

        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>

        <field name="arch" type="xml">

            <xpath expr="//app[@name='stock']" position="inside">

                <block title="Inter-Company Transfer"
                       name="intercompany_stock_transfer_settings">

                    <setting
                            string="Inter-Company Transit Location"
                            help="Shared transit location used between companies. It must have no company assigned so it can be used by multiple companies."
                            groups="intercompany_stock_transfer.group_intercompany_transfer_admin">

                        <field name="intercompany_transit_location_id"
                               options="{'no_create': False, 'no_open': False}"/>

                    </setting>

                </block>

            </xpath>

        </field>
    </record>
    <record id="view_company_form_short_code" model="ir.ui.view">
        <field name="name">res.company.form.short.code</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="short_code"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="filter_domain">[('short_code', 'ilike', self)]</attribute>
            </xpath>
        </field>
    </record>


</odoo>