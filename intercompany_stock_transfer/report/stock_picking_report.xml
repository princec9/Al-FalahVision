<odoo>
    <!-- Delivery Slip on inter-company transfers: show company short codes only -->

    <!-- Right side: destination company short code (replaces full warehouse address) -->
    <template id="report_delivery_document_ict" inherit_id="stock.report_delivery_document">
        <xpath expr="//div[@name='outgoing_warehouse_address']" position="attributes">
            <attribute name="t-elif">o.picking_type_id.code != 'internal' and o.picking_type_id.warehouse_id.partner_id and not o.intercompany_transfer_id</attribute>
        </xpath>
        <xpath expr="//div[@name='div_outgoing_address']" position="inside">
            <div name="ict_destination_company" t-if="o.intercompany_transfer_id">
                <strong>Destination Company</strong>
                <div t-out="o.intercompany_transfer_id.sudo().destination_company_id.short_code or o.intercompany_transfer_id.sudo().destination_company_id.name"/>
            </div>
        </xpath>
    </template>

    <!-- Left side (header): "Source Company" + short code only, only for inter-company pickings -->
    <template id="ict_external_layout_standard" inherit_id="web.external_layout_standard">
        <xpath expr="//ul[@name='company_address_list']" position="attributes">
            <attribute name="t-if">not (o and o._name == 'stock.picking' and o.intercompany_transfer_id)</attribute>
        </xpath>
        <xpath expr="//ul[@name='company_address_list']" position="before">
            <div t-if="o and o._name == 'stock.picking' and o.intercompany_transfer_id">
                <strong>Source Company</strong>
                <div t-out="o.intercompany_transfer_id.sudo().source_company_id.short_code or o.intercompany_transfer_id.sudo().source_company_id.name"/>
            </div>
        </xpath>
    </template>
</odoo>
