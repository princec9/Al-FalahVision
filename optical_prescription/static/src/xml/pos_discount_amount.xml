<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="optical_prescription.OrderlineDiscountAmount"
       t-inherit="point_of_sale.Orderline"
       t-inherit-mode="extension">

        <xpath expr="//li[@t-if='vals.discount']" position="after">
            <li t-if="vals.discountAmount" class="price-per-unit">
                <i class="fa fa-tag pe-1"/><em><t t-esc="vals.discountAmount"/></em> discount
                <t t-if="line.qty > 1"> (<t t-esc="vals.discountAmountUnit"/> / unit)</t>
            </li>
        </xpath>

    </t>

</templates>