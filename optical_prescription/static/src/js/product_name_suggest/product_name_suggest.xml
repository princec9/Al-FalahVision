<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="optical_prescription.ProductNameSuggestField">
        <div class="position-relative" t-on-input="onNameInput" t-on-focusout="onBlur">
            <t t-call="web.CharField"/>
            <div t-if="state.open"
                 class="o_product_suggest dropdown-menu show w-100"
                 style="max-height:300px; overflow:auto;">
                <div class="px-3 py-1 text-muted small">Existing products</div>
                <t t-foreach="state.suggestions" t-as="p" t-key="p.id">
                    <a href="#" class="dropdown-item"
                       t-on-mousedown.prevent="() => this.openProduct(p.id)">
                        <t t-if="p.default_code">[<t t-esc="p.default_code"/>] </t>
                        <t t-esc="p.name"/>
                    </a>
                </t>
            </div>
        </div>
    </t>
</templates>