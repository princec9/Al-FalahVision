<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="optical_prescription.ControlButtonsScan"
       t-inherit="point_of_sale.ControlButtons"
       t-inherit-mode="extension">

        <!-- Same anchor point used by the built-in "more" button, so the
             new Scan button sits on the main control row and is hidden
             automatically inside the "Actions" popup like the others. -->
        <xpath expr="//button[hasclass('more-btn')]" position="before">
            <button t-if="showScanButton"
                    class="btn btn-secondary btn-lg flex-shrink-0"
                    title="Scan Lot/Serial"
                    t-on-click="() => this.onClickScan()">
                <i class="fa fa-barcode" aria-hidden="true"/>
            </button>
        </xpath>
    </t>
</templates>
