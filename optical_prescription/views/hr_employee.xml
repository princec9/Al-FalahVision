<odoo>
    <data>

        <record id="view_hr_employee_form_inherit_custom" model="ir.ui.view">
            <field name="name">hr.employee.form.inherit.custom</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='parent_id']" position="after">
                    <field name="is_technician"/>
                    <field name="is_optometrist"/>
                        <field name="license_key" required="is_optometrist"/>

                </xpath>
                 <xpath expr="//group[@name='user']" position="inside">
            <field name="sale_discount_limit"/>
            <field name="discount_secret_key" password="True"/>
        </xpath>

            </field>
        </record>

    </data>
</odoo>
