<odoo>
    <data>


        <record id="view_fitting_parameters_form" model="ir.ui.view">
            <field name="name">fitting.parameters.form</field>
            <field name="model">fitting.parameters</field>
            <field name="arch" type="xml">
                <form string="Fitting Parameters">
                    <sheet>

                        <field name="sale_line_id" invisible="1"/>
                        <field name="prescription_id" invisible="1"/>

                        <div class="rounded card p-1" style="overflow:hidden;">
                            <table class="table mb-0">
                                <tbody>
                                    <tr class="bg-primary">
                                        <td class="fs-3 text-white text-center"
                                            colspan="6"
                                            style="background-color:#7a4f70;">
                                            <b>Fitting Parameters</b>
                                        </td>
                                    </tr>
                                    <tr class="bg-secondary">
                                        <td class="p-1 border-left-0 text-center"
                                            style="border:1px solid #b9b9b9 !important;">Shape
                                        </td>
                                        <td class="p-1 border text-center" style="border:1px solid #b9b9b9 !important;">
                                            Frame Type
                                        </td>
                                        <td class="p-1 border text-center" style="border:1px solid #b9b9b9 !important;">
                                            A Size
                                        </td>
                                        <td class="p-1 border text-center" style="border:1px solid #b9b9b9 !important;">
                                            B Size
                                        </td>
                                        <td class="p-1 border-left-0 text-center"
                                            style="border:1px solid #b9b9b9 !important;">DBL
                                        </td>
                                        <td class="p-1 border-left-0 text-center"
                                            style="border:1px solid #b9b9b9 !important;">Diameter
                                        </td>

                                    </tr>
                                    <tr>
                                        <td class="p-1 border-left-0" align="center">
                                            <field name="frame_shape"/>
                                        </td>
                                        <td class="p-1 border" align="center">
                                            <field name="frame_type"/>
                                        </td>
                                        <td class="p-1 border" align="center">
                                            <field name="frame_length"/>
                                        </td>
                                        <td class="p-1 border" align="center">
                                            <field name="frame_height"/>
                                        </td>
                                        <td class="p-1 border-right-0" align="center">
                                            <field name="frame_dbl"/>
                                        </td>
                                        <td class="p-1 border-left-0" align="center">
                                            <field name="frame_diameter"/>
                                        </td>
                                    </tr>
                                    <tr class="bg-secondary">
                                        <td class="p-1 border text-center" style="border:1px solid #b9b9b9 !important;">
                                            Thickness Type
                                        </td>
                                        <td class="p-1 border text-center" style="border:1px solid #b9b9b9 !important;">
                                            PD Height(R)
                                        </td>
                                        <td class="p-1 border text-center" style="border:1px solid #b9b9b9 !important;">
                                            PD Height(L)
                                        </td>
                                        <td class="p-1 border text-center" style="border:1px solid #b9b9b9 !important;">
                                            Segment Height
                                        </td>
                                        <td class="p-1 border-left-0 text-center"
                                            style="border:1px solid #b9b9b9 !important;">Index
                                        </td>
                                        <td class="p-1 border text-center" style="border:1px solid #b9b9b9 !important;">
                                            IPD
                                        </td>
                                    </tr>
                                    <tr>

                                        <td class="p-1 border" align="center">
                                            <field name="frame_thickness_type"/>
                                        </td>
                                        <td class="p-1 border" align="center">
                                            <field name="frame_pd_height_r"/>
                                        </td>
                                        <td class="p-1 border" align="center">
                                            <field name="frame_pd_height_l"/>
                                        </td>
                                        <td class="p-1 border-right-0" align="center">
                                            <field name="frame_segment_height"/>
                                        </td>
                                        <td class="p-1 border-left-0" align="center">
                                            <field name="frame_index"/>
                                        </td>
                                        <td class="p-1 border" align="center">
                                            <field name="frame_ipd"/>
                                        </td>
                                    </tr>


                                </tbody>
                            </table>
                        </div>

                    </sheet>
                </form>
            </field>
        </record>


        <!-- =========================================================
             SALE ORDER REPORT
             ========================================================= -->
        <template id="report_saleorder_document_incharge_discount"
                  inherit_id="sale.report_saleorder_document">

            <!-- =====================================================
                 ORDER SALESPERSON -> INCHARGE
                 ===================================================== -->
            <xpath expr="//div[@id='informations']//strong[normalize-space()='Salesperson']"
                   position="replace">
                <strong>Incharge</strong>
            </xpath>


            <!-- =====================================================
                 ADD DISCOUNT AMOUNT HEADER
                 After existing Discount % column
                 ===================================================== -->
            <xpath expr="//th[@name='th_discount']"
                   position="after">

                <th name="th_discount_amount"
                    class="text-end text-nowrap">
                    <span>Disc. Amount</span>
                </th>

            </xpath>


            <!-- =====================================================
                 ADD SALES PERSON HEADER
                 After Discount Amount
                 ===================================================== -->
            <xpath expr="//th[@name='th_discount_amount']"
                   position="after">

                <th name="th_salesperson"
                    class="text-end text-nowrap">
                    <span>Sales Person</span>
                </th>

            </xpath>


            <!-- =====================================================
                 NORMAL / LAB COMPONENT LINE
                 DISCOUNT AMOUNT
                 ===================================================== -->
            <xpath expr="//td[@name='td_product_discount']"
                   position="after">

                <td name="td_product_discount_amount"
                    class="text-end text-nowrap">

                    <span t-field="line.discount_amount"
                          t-options="{
                              'widget': 'monetary',
                              'display_currency': doc.currency_id
                          }"/>

                </td>

            </xpath>


            <!-- =====================================================
                 NORMAL / LAB COMPONENT LINE
                 SALES PERSON
                 ===================================================== -->
            <xpath expr="//td[@name='td_product_discount_amount']"
                   position="after">

                <td name="td_product_salesperson"
                    class="text-end text-nowrap">

                    <span t-field="line.user_id"/>

                </td>

            </xpath>


            <!-- =====================================================
                 SECTION LINE
                 
                 Original:
                 3 + discount + taxes

                 Added:
                 2 columns

                 New:
                 5 + discount + taxes
                 ===================================================== -->
            <xpath expr="//td[@name='td_section_name']"
                   position="attributes">

                <attribute name="t-att-colspan">
                    5 + (1 if display_discount else 0) + (1 if display_taxes else 0)
                </attribute>

            </xpath>


            <!-- =====================================================
                 COMBO LINE
                 ===================================================== -->
            <xpath expr="//td[@name='td_combo_name']"
                   position="attributes">

                <attribute name="t-att-colspan">
                    5 + (1 if display_discount else 0) + (1 if display_taxes else 0)
                </attribute>

            </xpath>

        </template>

    </data>
</odoo>
