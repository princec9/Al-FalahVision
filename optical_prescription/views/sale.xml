<record id="quality_check_view_form_inherit_employee" model="ir.ui.view">
    <field name="name">quality.check.form.inherit.employee</field>
    <field name="model">quality.check</field>
    <field name="inherit_id" ref="quality_control.quality_check_view_form"/>
    <field name="arch" type="xml">

        <!-- Add a new page after Notes -->
       <xpath expr="//field[@name='additional_note']" position="after">
            <field name="assigned_employee_id"/>
        </xpath>

    </field>
</record>

        <record id="quality_check_view_form_inherit_failure_message"
                model="ir.ui.view">

            <field name="name">quality.check.wizard.failure.reason</field>

            <field name="model">quality.check.wizard</field>

            <field name="inherit_id"
                   ref="quality_control.view_quality_check_wizard"/>

            <field name="arch" type="xml">
                <xpath expr="//field[@name='note']"
                       position="attributes">

                    <attribute name="readonly">0</attribute>

                </xpath>
                <xpath expr="//field[@name='additional_note']" position="after">

                    <group col="1" class="mt-3">

                        <field name="assigned_employee_id"
                               string="Conducted Person"/>

                        <field name="failure_reason"
                               string="Failure Reason"
                               placeholder="Enter failure reason..."
                               invisible="test_type != 'passfail'"/>

                        <field name="failure_action"
                               string="Failure Action"
                               placeholder="Enter next action..."
                               invisible="test_type != 'passfail'"/>

                    </group>


                </xpath>
            </field>

        </record>


        <record id="view_move_form_inherit_discount_amount"
                model="ir.ui.view">

            <field name="name">
                account.move.form.discount.amount
            </field>

            <field name="model">account.move</field>

            <field name="inherit_id"
                   ref="account.view_move_form"/>

            <field name="arch"
                   type="xml">
                <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='discount']"
                       position="before">
                    <field name="user_id" string="Salesperson" optional="show"/>


                </xpath>
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_open_prescription"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-eye"
                            invisible="move_type != 'out_invoice' or prescription_count == 0">
                        <field name="prescription_count" widget="statinfo" string="Prescriptions"/>
                    </button>
                </xpath>
                <xpath expr="//header" position="inside">
                    <button name="action_add_prescription"
                            string="Add Prescription"
                            type="object"
                            class="btn btn-primary"
                            invisible="move_type != 'out_invoice' or not is_reimbursement or not id"/>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='discount']"
                       position="after">

                    <field name="discount_amount"
                           string="Disc. Amount"
                           optional="hide"/>

                </xpath>

            </field>

        </record>

        <template id="report_saleorder_document_discount_amount"
                  inherit_id="sale.report_saleorder_document">

            <xpath expr="//th[@name='th_discount']"
                   position="after">

                <th name="th_discount_amount"
                    t-if="display_discount"
                    class="text-end">
                    <span>Disc. Amount</span>
                </th>

            </xpath>

            <xpath expr="//td[@name='td_product_discount']"
                   position="after">

                <td name="td_discount_amount"
                    t-if="display_discount"
                    class="text-end">

                    <t t-if="not collapse_prices">
                        <span t-field="line.discount_amount"
                              t-options="{
                          'widget': 'monetary',
                          'display_currency': line.currency_id
                      }"/>
                    </t>

                </td>

            </xpath>
        </template>
