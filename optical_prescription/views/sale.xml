        <record id="sale_commission_plan_view_form_inherit" model="ir.ui.view">
    <field name="name">sale.commission.plan.form.inherit</field>
    <field name="model">sale.commission.plan</field>
    <field name="inherit_id" ref="sale_commission.sale_commission_plan_view_form"/>
    <field name="arch" type="xml">

        <!-- Add after User Type -->
        <xpath expr="//field[@name='user_type']" position="after">
            <field name="commission_based_on"
                   readonly="state != 'draft'"
                   invisible="user_type != 'person'"/>
        </xpath>
    </field>
</record>

<record id="view_delivery_scan_wizard_form" model="ir.ui.view">
    <field name="name">delivery.scan.wizard.form</field>
    <field name="model">delivery.scan.wizard</field>
    <field name="arch" type="xml">
        <form string="Scan Delivery">
            <sheet>
                <div class="text-center">
                    <h2>
                        <i class="fa fa-barcode"/> Lot Verification
                    </h2>
                    <div class="text-muted">
                        Delivery: <field name="picking_id"/>
                    </div>
                </div>

                <!-- ✅ PROGRESS INDICATOR -->
                <div class="alert alert-info text-center mt-3">
                    <h4>
                        <span style="font-size: 24px;">
                            <field name="scanned_count"/>
                            /
                            <field name="total_count"/>
                        </span>
                    </h4>
                    <p>Lots Scanned</p>
                </div>

                <!-- ✅ STATUS MESSAGE - SCANNING IN PROGRESS -->
<!--                <div class="alert alert-warning text-center mt-2">-->
<!--                    <h4>Scanning in progress...</h4>-->
<!--                    <p>Scan all <field name="total_count"/> lots to complete</p>-->
<!--                </div>-->

<!--                &lt;!&ndash; ✅ STATUS MESSAGE - ALL SCANNED (shown via compute field) &ndash;&gt;-->
<!--                <div class="alert alert-success text-center mt-2">-->
<!--                    <h4>✅ All lots scanned!</h4>-->
<!--                    <p>You can now confirm the scan.</p>-->
<!--                </div>-->

                <!-- ✅ SCAN INPUT -->
                <div class="alert alert-info text-center mt-3">
                    <h4>
                        <i class="fa fa-barcode"/>
                        Scan Serial Number
                    </h4>
                    <field name="scan_barcode"
                           placeholder="Scan barcode here..."
                           class="text-center"
                           autofocus="autofocus"/>
                    <button name="action_scan"
                            type="object"
                            string="Scan"
                            class="btn-primary mt-2"
                            icon="fa-barcode"/>
                </div>

                <!-- ✅ LOTS TABLE -->
                <separator string="Lots to Scan"/>

                <field name="scan_line_ids"
                       nolabel="1">
                    <list create="0"
                          delete="0"
                          editable="bottom">
                        <field name="product_id"
                               string="Product"/>
                        <field name="barcode"
                               string="Lot/Serial"/>
                        <field name="expiration_date"
                               widget="date"
                               string="Expiration Date"/>
                        <field name="scanned"
                               widget="boolean"
                               string="✓ Scanned"/>
                    </list>
                </field>

                <!-- ✅ INSTRUCTIONS -->
                <div class="alert alert-info mt-3">
                    <strong>Instructions:</strong>
                    <ul>
                        <li>Scan each lot/serial number in the list above</li>
                        <li>You can scan in any order</li>
                        <li>Progress shows: X/Y lots scanned</li>
                        <li><strong>Confirm button is only enabled when ALL lots are scanned</strong></li>
                    </ul>
                </div>
            </sheet>
            <footer>
                <!-- ✅ BUTTON DISABLED UNTIL ALL SCANNED -->
                <button name="action_confirm"
                        type="object"
                        string="Confirm Scan"
                        class="btn-primary"/>
                <button string="Cancel"
                        special="cancel"
                        class="btn-secondary"/>
            </footer>
        </form>
    </field>
</record>


        <record id="view_picking_form_qc_inherit" model="ir.ui.view">
    <field name="name">stock.picking.form.qc.inherit</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form"/>
    <field name="arch" type="xml">

        <xpath expr="//header" position="inside">
<!--<button name="action_quality_checks"-->
<!--        type="object"-->
<!--        string="Scan"-->
<!--        class="btn-success"-->
<!--        icon="fa-barcode"-->
<!--        invisible="picking_type_code != 'outgoing' or state not in ['assigned', 'confirmed'] or scan_completed"/>-->

           <button
                name="action_quality_checks"
                type="object"
                string="Scan"
                class="btn-success"
                icon="fa-barcode"
                invisible="picking_type_code != 'outgoing' or state not in ['assigned', 'confirmed'] or scan_completed or not has_lot_lines"/>

            <button name="action_open_qc_wizard"
                    type="object"
                    string="Quality"
                    class="btn-primary"
                    invisible="picking_type_code != 'incoming' or state != 'done' or qc_done"/>

        </xpath>

        <xpath expr="//sheet" position="inside">
            <widget name="web_ribbon"
                    title="Quality Checked"
                    bg_color="text-bg-success"
                    invisible="not qc_done"/>
        </xpath>

    </field>
</record>
<record id="view_stock_picking_qc_wizard_form" model="ir.ui.view">
