<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="purchase_report_search_brand" model="ir.ui.view">
        <field name="name">purchase.report.search.brand</field>
        <field name="model">purchase.report</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='group_category_id']" position="after">
                <filter string="Brand" name="group_brand_id"
                        context="{'group_by': 'brand_id'}"/>
                <filter string="Location" name="group_short_code"
                        context="{'group_by': 'short_code'}"/>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="brand_id"/>
                <field name="short_code"/>
            </xpath>
        </field>
    </record>
</odoo>