<odoo>
    <data>


<!-- Product Template Form View -->
<record id="product_template_form_view_inherit_warranty" model="ir.ui.view">
    <field name="name">product.template.form.inherit.warranty</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_only_form_view"/>
    <field name="arch" type="xml">
        <xpath expr="//page[@name='general_information']" position="inside">

                <group>
                    <field name="is_lab_order"/>

                </group>
        </xpath>

    </field>
</record>


<!-- Product Variant Form View -->
<record id="product_variant_form_view_inherit_warranty" model="ir.ui.view">
    <field name="name">product.product.form.inherit.warranty</field>
    <field name="model">product.product</field>
    <field name="inherit_id" ref="product.product_normal_form_view"/>
    <field name="arch" type="xml">

<xpath expr="//page[@name='general_information']" position="inside">

                <group>
                    <field name="is_lab_order"/>

                </group>
        </xpath>
    </field>
</record>



        <record id="sph_cyl_tree" model="ir.ui.view">
            <field name="name">SPH.CYL</field>
            <field name="model">sph.cyl</field>
            <field name="arch" type="xml">
                <list string="Powers" editable="bottom">
                    <field name="name" string="Power" required="1"/>
                </list>
            </field>
        </record>

        <record id="power_add_tree" model="ir.ui.view">
            <field name="name">ADD</field>
            <field name="model">power.add</field>
            <field name="arch" type="xml">
                <list string="Powers" editable="top">
                    <field name="name" string="Power" required="1"/>
                </list>
            </field>
        </record>
        <record id="fitting_type_tree" model="ir.ui.view">
            <field name="name">Fitting Type</field>
            <field name="model">fitting.type</field>
            <field name="arch" type="xml">
                <list string="Fitting Type" editable="top">
                    <field name="name" string="Label" required="1"/>
                </list>
            </field>
        </record>

        <record id="product_sph_cyl" model="ir.actions.act_window">
            <field name="name">SPH &amp; CYL</field>
            <field name="res_model">sph.cyl</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="sph_cyl_tree"/>
        </record>
        <record id="product_add_power" model="ir.actions.act_window">
            <field name="name">ADD</field>
            <field name="res_model">power.add</field>
            <field name="view_mode">list,form</field>
        </record>
        <record id="action_fitting_type" model="ir.actions.act_window">
            <field name="name">Fitting Types</field>
            <field name="res_model">fitting.type</field>
            <field name="view_mode">list</field>
        </record>

    </data>
</odoo>
