<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="product_category_form_view_followup" model="ir.ui.view">
        <field name="name">product.category.form.followup</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//group[@name='first']" position="after">
                <group string="Customer Follow Up">
                    <field name="followup"/>
                    <field name="activity_type_id"
                           invisible="not followup"/>
                    <field name="followup_month"
                           invisible="not followup"/>
                </group>
            </xpath>

        </field>
    </record>

    <record id="view_partner_prescription_form" model="ir.ui.view">
        <field name="name">res.partner.prescription.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object"
                        class="oe_stat_button"
                        name="action_view_prescriptions"
                        icon="fa-plus"
                        invisible="prescription_count == 0">

                    <field name="prescription_count"
                           widget="statinfo"
                           string="Prescriptions"/>
                </button>
            </xpath>

            <xpath expr="//div[@class='o_address_format']" position="after">
                <field name="dob"/>
                 <field name="is_optometrist_person"/>
                 <field name="is_technician"/>
            </xpath>

            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="emp_personal"/>
            </xpath>

        </field>
    </record>
