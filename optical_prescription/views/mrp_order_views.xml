<odoo>

    <record id="view_mrp_production_form_view_inherit_custom" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.custom</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">

                  <field name="technician_id" invisible="1"/>
                  <field name="technician_contact_id"/>
            </xpath>
            <xpath expr="//page[@name='operations']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//form/sheet/notebook/page[@name='components']" position="after">
                <page name="prescription" string="Prescription">
                    <field name="prescription_ids" readonly="1">
                        <list>
                            <field name="display_name"/>
                            <field name="prescribed_by"/>
                            <field name="optometrist_id"/>
                            <field name="partner_id"/>
                            <field name="fitting_type_id"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
                <page name="fitting_parameters" string="Fitting Parameters">
                    <field name="related_sale_order_line_id" invisible="1"/>
                    <field name="fitting_parameter_ids" readonly="1" mode="list,form"
                           context="{'default_sale_line_id': related_sale_order_line_id}">
                        <list readonly="1">
                            <field name="frame_shape"/>
                            <field name="frame_type"/>
                            <field name="frame_length"/>
                            <field name="frame_height"/>
                            <field name="frame_dbl"/>
                            <field name="frame_diameter"/>
                            <field name="frame_thickness_type"/>
                            <field name="frame_pd_height_r"/>
                            <field name="frame_pd_height_l"/>
                            <field name="frame_index"/>
                            <field name="frame_ipd"/>
                            <field name="frame_segment_height"/>
                        </list>
                <form string="Fitting Parameters">
                    <sheet>

                        <field name="sale_line_id" invisible="1"/>
                        <field name="prescription_id" invisible="1"/>

                        <div class="rounded card p-1" style="overflow:hidden;">
                            <table class="table mb-0">
                                <tbody>
                                    <tr class="bg-primary">
                                        <td class="fs-3 text-white text-center"
                                            colspan="6"
                                            style="background-color:#7a4f70;">
                                            <b>Fitting Parameters</b>
                                        </td>
                                    </tr>
                                    <tr class="bg-secondary">
                                        <td class="p-1 border-left-0 text-center"
                                            style="border:1px solid #b9b9b9 !important;">Shape
                                        </td>
                                        <td class="p-1 border text-center" style="border:1px solid #b9b9b9 !important;">
                                            Frame Type
                                        </td>
                                        <td class="p-1 border text-center" style="border:1px solid #b9b9b9 !important;">
                                            A Size
                                        </td>
                                        <td class="p-1 border text-center" style="border:1px solid #b9b9b9 !important;">
                                            B Size
                                        </td>
                                        <td class="p-1 border-left-0 text-center"
                                            style="border:1px solid #b9b9b9 !important;">DBL
                                        </td>
                                        <td class="p-1 border-left-0 text-center"
                                            style="border:1px solid #b9b9b9 !important;">Diameter
                                        </td>

                                    </tr>
                                    <tr>
                                        <td class="p-1 border-left-0" align="center">
                                            <field name="frame_shape"/>
                                        </td>
                                        <td class="p-1 border" align="center">
                                            <field name="frame_type"/>
                                        </td>
                                        <td class="p-1 border" align="center">
                                            <field name="frame_length"/>
                                        </td>
                                        <td class="p-1 border" align="center">
                                            <field name="frame_height"/>
                                        </td>
                                        <td class="p-1 border-right-0" align="center">
                                            <field name="frame_dbl"/>
                                        </td>
                                        <td class="p-1 border-left-0" align="center">
                                            <field name="frame_diameter"/>
                                        </td>
                                    </tr>
                                    <tr class="bg-secondary">
                                        <td class="p-1 border text-center" style="border:1px solid #b9b9b9 !important;">
                                            Thickness Type
                                        </td>
                                        <td class="p-1 border text-center" style="border:1px solid #b9b9b9 !important;">
                                            PD Height(R)
                                        </td>
                                        <td class="p-1 border text-center" style="border:1px solid #b9b9b9 !important;">
                                            PD Height(L)
                                        </td>
                                        <td class="p-1 border text-center" style="border:1px solid #b9b9b9 !important;">
                                            Segment Height
                                        </td>
                                        <td class="p-1 border-left-0 text-center"
                                            style="border:1px solid #b9b9b9 !important;">Index
                                        </td>
                                        <td class="p-1 border text-center" style="border:1px solid #b9b9b9 !important;">
                                            IPD
                                        </td>
                                    </tr>
                                    <tr>

                                        <td class="p-1 border" align="center">
                                            <field name="frame_thickness_type"/>
                                        </td>
                                        <td class="p-1 border" align="center">
                                            <field name="frame_pd_height_r"/>
                                        </td>
                                        <td class="p-1 border" align="center">
                                            <field name="frame_pd_height_l"/>
                                        </td>
                                        <td class="p-1 border-right-0" align="center">
                                            <field name="frame_segment_height"/>
                                        </td>
                                        <td class="p-1 border-left-0" align="center">
                                            <field name="frame_index"/>
                                        </td>
                                        <td class="p-1 border" align="center">
                                            <field name="frame_ipd"/>
                                        </td>
                                    </tr>


                                </tbody>
                            </table>
                        </div>

                    </sheet>
                </form>

                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>