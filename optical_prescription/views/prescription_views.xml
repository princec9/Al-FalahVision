<odoo>
    <data>

        <record model="ir.ui.view" id="view_prescription_mixin_tree">
            <field name="model">prescription.records</field>
            <field name="arch" type="xml">
                <list>
                    <field name="create_date"/>
                    <field name="res_model" column_invisible="1"/>
                    <field name="line_res_id" string="DOC #"/>
                    <!--                    <field name="product_tmpl_id"/>-->
                    <field name="new_rsph" optional="show" string="Right SPH"/>
                    <field name="new_rcyl" optional="show" string="Right CYL"/>
                    <field name="new_raxis" optional="hide" string="Right Axis"/>
                    <field name="new_radd" optional="hide" string="Right ADD"/>
                    <field name="new_rpd" optional="hide" string="Right IPD"/>

                    <field name="new_lsph" optional="show" string="Left SPH"/>
                    <field name="new_lcyl" optional="show" string="Left CYL"/>
                    <field name="new_laxis" optional="hide" string="Left AXIS"/>
                    <field name="new_ladd" optional="hide" string="Left ADD"/>
                    <field name="new_lpd" optional="hide" string="Left IPD"/>
                    <field name="visit_purpose_note" string="Visit Purpose"/>
                    <field name="prescribed_by"/>
                    <!-- <field name="optometrist_id"/> -->
                    <!-- <field name="optometrist_partner_id"/> -->
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="view_prescription_mixin_form_only">
            <field name="model">prescription.records</field>
            <field name="arch" type="xml">
                <form>
                      <header>
        <button name="action_view_previous_prescriptions"
                type="object"
                class="oe_stat_button"
                icon="fa-history">
            <field name="previous_prescription_count"
                   widget="statinfo"
                   string="Previous Prescriptions"/>
        </button>
    </header>


                    <!--                    <header>-->
                    <!--                        <field name="state" widget="statusbar" statusbar_visible="draft,sale,cancel" nolabel="1" />-->
                    <!--                    </header>-->
                    <div class="rounded card mb-4 p-1" style="overflow:hidden;">
                        <table class="table mb-0"
                               style=""
                               cellspacing="0" border="0">
                            <tbody>
                                <tr class="bg-primary">
                                    <td class="fs-3 text-white"
                                        align="center" colspan="6">
                                        <b>PRESCRIPTION</b>
                                    </td>
                                </tr>
                                <tr class="bg-secondary">
                                    <td style="border:1px solid #b9b9b9 !important;" class="border-left-0"
                                        align="center">
                                    </td>
                                    <td style="border:1px solid #b9b9b9 !important;" class="border"
                                        align="center">
                                        <b>SPH</b>
                                    </td>
                                    <td style="border:1px solid #b9b9b9 !important;" class="border"
                                        align="center">
                                        <b>CYL</b>
                                    </td>
                                    <td style="border:1px solid #b9b9b9 !important;" class="border"
                                        align="center">
                                        <b>AXIS</b>
                                    </td>
                                    <td style="border:1px solid #b9b9b9 !important;" class="border"
                                        align="center">
                                        <b>ADD</b>
                                    </td>
                                    <td style="border:1px solid #b9b9b9 !important;" class="border-right-0"
                                        align="center">
                                        <b>V/A</b>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border:1px solid #b9b9b9 !important;" class="border-left-0 bg-secondary"
                                        align="center">
                                        <b>RE</b>
                                    </td>
                                    <td class="p-1 border"
                                        align="center">
                                        <field name="new_rsph" class="fs-5 mt-2"
                                               options="{'no_open': True, 'no_create': True}"/>
                                    </td>
                                    <td class="p-1 border"
                                        align="center">
                                        <field name="new_rcyl" class="fs-5 mt-2"
                                               options="{'no_open': True, 'no_create': True}"/>
                                    </td>
                                    <td class="p-1 border"
                                        align="center">
                                        <field name="new_raxis" class="fs-5 mt-2"/>
                                    </td>
                                    <td class="p-1 border"
                                        align="center">
                                        <field name="new_radd" class="fs-5 mt-2"
                                               options="{'no_open': True, 'no_create': True}"/>
                                    </td>
                                    <td class="p-1 border-right-0"
                                        align="center">
                                        <field name="new_rpd" class="fs-5 mt-2"/>
                                    </td>
                                </tr>
                                <tr class="">
                                    <td style="width:12%;border:1px solid #b9b9b9 !important;"
                                        class="border-left-0 bg-secondary"
                                        align="center">
                                        <b>LE</b>
                                    </td>
                                    <td class="p-1 border"
                                        align="center">
                                        <field name="new_lsph" class="fs-5 mt-2"
                                               options="{'no_open': True, 'no_create': True}"/>
                                    </td>
                                    <td class="p-1 border" align="center">
                                        <field name="new_lcyl" class="fs-5 mt-2"
                                               options="{'no_open': True, 'no_create': True}"/>
                                    </td>
                                    <td class="p-1 border"
                                        align="center">
                                        <field name="new_laxis" class="fs-5 mt-2"/>
                                    </td>
                                    <td class="p-1 border"
                                        align="center">
                                        <field name="new_ladd" class="fs-5 mt-2"
                                               options="{'no_open': True, 'no_create': True}"/>
                                    </td>
                                    <td class="p-1 border-right-0"
                                        align="center">
                                        <field name="new_lpd" class="fs-5 mt-2"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <group>
                        <group>
                            <field name="product_tmpl_id" readonly="1" string="Product" invisible="1"/>
                            <field name="order_id" invisible="1" string="Product"/>
                        </group>
                        <group>
                            <field name="res_id" readonly="1" string="Line" invisible="1"/>
                            <field name="partner_id" invisible="1" string="Partner"/>
                        </group>
                    </group>
                    <hr/>
                    <group>
                        <group string="Visit Details">
                            <field name="visit_purpose_note"/>
                            <field name="prescribed_by"/>
                            <field name="optometrist_partner_id" domain="[('is_optometrist_person', '=', True)]"/>
                            <!-- <field name="optometrist_id"  /> -->
                                                <field name="license_key"/>


                          
                        </group>

                        <field name="note" widget="text" placeholder="Enter Your Description Here..."/>
                    </group>


