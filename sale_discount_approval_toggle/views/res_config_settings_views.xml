<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_discount_approval" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.discount.approval</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='sale_management']" position="inside">
                <block title="Discount Approval" name="discount_approval_block">
                    <setting id="sale_discount_approval"
                             help="Require approval when a line discount exceeds the salesperson's limit.">
                        <field name="sale_discount_approval"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
